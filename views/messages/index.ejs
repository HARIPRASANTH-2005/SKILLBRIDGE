<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     PROJECT MESSAGING — SkillBridge
     Charcoal-Black & Slate-Gray Monochrome Interface
══════════════════════════════════════════════════════════ -->

<section class="section" style="padding-top: var(--sp-12); height: calc(100vh - 64px); display: flex; flex-direction: column;">
  <div class="section-container" style="flex: 1; display: flex; flex-direction: column;">

    <div class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <span>Project Messaging</span>
    </div>

    <div class="card" style="flex: 1; display: grid; grid-template-columns: 280px 1fr; padding: 0; overflow: hidden; margin-bottom: var(--sp-6);">

      <!-- Left Conversations List -->
      <aside style="border-right: 1px solid var(--clr-border); background: var(--clr-bg-subtle); display: flex; flex-direction: column;">
        <div style="padding: var(--sp-4); border-bottom: 1px solid var(--clr-border);">
          <strong style="font-size: var(--fs-sm);">Active Projects (2)</strong>
        </div>

        <div style="overflow-y: auto; flex: 1;">
          <div style="padding: var(--sp-4); border-bottom: 1px solid var(--clr-border); background: var(--clr-card); cursor: pointer;">
            <div class="d-flex justify-between align-center mb-1">
              <strong style="font-size: var(--fs-xs);">Placement Engine</strong>
              <span class="text-muted" style="font-size: 0.65rem;">11:42 AM</span>
            </div>
            <div class="text-secondary" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              Karthik (Mentor): Code looks clean. Merging PR #4.
            </div>
          </div>

          <div style="padding: var(--sp-4); border-bottom: 1px solid var(--clr-border); cursor: pointer;">
            <div class="d-flex justify-between align-center mb-1">
              <strong style="font-size: var(--fs-xs);">GraphQL Microservice</strong>
              <span class="text-muted" style="font-size: 0.65rem;">Yesterday</span>
            </div>
            <div class="text-secondary" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              Divya (Mentor): Check the Redis key TTL settings.
            </div>
          </div>
        </div>
      </aside>

      <!-- Right Active Message Thread -->
      <div style="display: flex; flex-direction: column; background: var(--clr-card);">
        
        <!-- Thread Header -->
        <div style="padding: var(--sp-4) var(--sp-6); border-bottom: 1px solid var(--clr-border); display: flex; justify-content: space-between; align-items: center;">
          <div>
            <strong style="font-size: var(--fs-base);">Campus Placement Assessment Engine</strong>
            <div class="text-muted" style="font-size: var(--fs-xs);">
              Participants: Karthik Subramaniam (Alumni Mentor) &amp; Hari Prasanth M (Student)
            </div>
          </div>
          <a href="/projects/1/tasks" class="btn btn-sm btn-secondary">View Task Board</a>
        </div>

        <!-- Chat Stream -->
        <div style="flex: 1; padding: var(--sp-6); overflow-y: auto; display: flex; flex-direction: column; gap: var(--sp-4);">
          
          <!-- Message 1 from Mentor -->
          <div style="max-width: 75%; align-self: flex-start;">
            <div style="font-size: 0.7rem; color: var(--clr-text-muted); margin-bottom: 2px;">
              Karthik Subramaniam (Mentor) · Oct 28, 10:15 AM
            </div>
            <div style="background: var(--clr-surface-elevated); border: 1px solid var(--clr-border); padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-lg); font-size: var(--fs-sm); line-height: 1.6;">
              Hi Hari, I reviewed the Docker compose configuration. Make sure to mount the test fixture volumes as read-only (<code>:ro</code>) so the evaluated student code cannot overwrite test cases.
            </div>
          </div>

          <!-- Message 2 from Student -->
          <div style="max-width: 75%; align-self: flex-end;">
            <div style="font-size: 0.7rem; color: var(--clr-text-muted); margin-bottom: 2px; text-align: right;">
              Hari Prasanth M (Student) · Oct 28, 10:48 AM
            </div>
            <div style="background: var(--clr-bg-subtle); border: 1px solid var(--clr-border); padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-lg); font-size: var(--fs-sm); line-height: 1.6;">
              Got it, Karthik! I just updated the Dockerode container spawn options to use <code>Binds: ['/fixtures:/fixtures:ro']</code> and tested it with a script that tries to write to fixtures — it threw permission denied as expected.
            </div>
          </div>

          <!-- Message 3 from Mentor -->
          <div style="max-width: 75%; align-self: flex-start;">
            <div style="font-size: 0.7rem; color: var(--clr-text-muted); margin-bottom: 2px;">
              Karthik Subramaniam (Mentor) · Today, 11:42 AM
            </div>
            <div style="background: var(--clr-surface-elevated); border: 1px solid var(--clr-border); padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-lg); font-size: var(--fs-sm); line-height: 1.6;">
              Code looks clean. Merging PR #4 now. Let's start on the memory profiler milestone next.
            </div>
          </div>

        </div>

        <!-- Composer -->
        <div style="padding: var(--sp-4); border-top: 1px solid var(--clr-border); background: var(--clr-bg-subtle);">
          <form class="d-flex gap-3">
            <input
              type="text"
              class="form-control"
              placeholder="Type your technical project message..."
              style="flex: 1;"
            />
            <button type="button" class="btn btn-primary">Send ↗</button>
          </form>
        </div>

      </div>

    </div>

  </div>
</section>

<%- include('../partials/footer') %>

