
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<section class="section" style="padding-top: var(--sp-6);">
  <div class="section-container" style="max-width: 1140px;">

    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Project Messaging</span>
    </nav>

    <div class="card"
      style="display:grid;grid-template-columns:280px 1fr;padding:0;overflow:hidden;height:calc(100vh - 180px);min-height:500px;">

      <!-- LEFT: CONVERSATION LIST -->
      <aside style="border-right:1px solid var(--clr-border);background:var(--clr-bg-subtle);display:flex;flex-direction:column;overflow:hidden;">

        <div style="padding:var(--sp-4) var(--sp-5);border-bottom:1px solid var(--clr-border);background:var(--clr-surface);">
          <strong style="font-size:var(--fs-sm);color:var(--clr-text);">
            Messages
            <span class="text-muted" style="font-weight:400;">
              (<%= conversations.length %>)
            </span>
          </strong>
        </div>

        <div style="overflow-y:auto;flex:1;">

          <% if (conversations.length > 0) { %>

            <% conversations.forEach(conv => { %>

              <a href="/messages/<%= conv._id %>"
                style="display:block;text-decoration:none;padding:var(--sp-4) var(--sp-5);border-bottom:1px solid var(--clr-border);background:<%= activeConversation && activeConversation._id === conv._id ? 'var(--clr-surface)' : 'transparent' %>;">

                <div class="d-flex justify-between align-center mb-1">
                  <strong style="font-size:var(--fs-xs);color:var(--clr-text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px;">
                    <%= conv.projectTitle %>
                  </strong>

                  <span class="text-muted" style="font-size:0.65rem;flex-shrink:0;margin-left:var(--sp-2);">
                    <% if (conv.lastMessageTime) { %>
                      <%= new Date(conv.lastMessageTime).toLocaleDateString('en-IN') %>
                    <% } %>
                  </span>
                </div>

                <div class="text-secondary" style="font-size:0.75rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                  <%= conv.lastMessage %>
                </div>

              </a>

            <% }) %>

          <% } else { %>

            <div style="padding:var(--sp-5);text-align:center;">
              <p class="text-muted" style="font-size:var(--fs-xs);">
                No project conversations yet.
              </p>
            </div>

          <% } %>

        </div>
      </aside>


      <!-- RIGHT: ACTIVE CONVERSATION -->
      <div style="display:flex;flex-direction:column;background:var(--clr-surface);overflow:hidden;">

        <% if (activeConversation) { %>

          <!-- THREAD HEADER -->
          <div style="padding:var(--sp-4) var(--sp-6);border-bottom:1px solid var(--clr-border);display:flex;justify-content:space-between;align-items:center;flex-shrink:0;">

            <div>
              <strong style="font-size:var(--fs-base);color:var(--clr-text);">
                <%= activeConversation.projectTitle %>
              </strong>

              <div class="text-muted" style="font-size:var(--fs-xs);">
                <%= activeConversation.participantNames || 'Project participants' %>
              </div>
            </div>

            <a href="/projects/<%= activeConversation.projectId %>"
              class="btn btn-sm btn-secondary">
              View Project
            </a>

          </div>


          <!-- CHAT STREAM -->
          <div style="flex:1;padding:var(--sp-6);overflow-y:auto;display:flex;flex-direction:column;gap:var(--sp-4);">

            <% if (messages.length > 0) { %>

              <% messages.forEach(msg => { %>

                <% const isOwnMessage = currentUser && msg.senderId === currentUser._id.toString(); %>

                <div style="max-width:72%;align-self:<%= isOwnMessage ? 'flex-end' : 'flex-start' %>;">

                  <div style="font-size:0.7rem;color:var(--clr-text-muted);margin-bottom:3px;text-align:<%= isOwnMessage ? 'right' : 'left' %>;">
                    <%= msg.senderName %>
                    ·
                    <%= new Date(msg.createdAt).toLocaleTimeString('en-IN', {hour:'2-digit',minute:'2-digit'}) %>
                  </div>

                  <div style="background:<%= isOwnMessage ? 'var(--clr-primary-light)' : 'var(--clr-surface-elevated)' %>;border:1px solid <%= isOwnMessage ? 'var(--clr-primary-border)' : 'var(--clr-border)' %>;padding:var(--sp-3) var(--sp-4);border-radius:var(--radius-lg);font-size:var(--fs-sm);line-height:1.6;color:var(--clr-text);">

                    <%= msg.content %>

                  </div>

                </div>

              <% }) %>

            <% } else { %>

              <div style="margin:auto;text-align:center;">
                <p class="text-muted">
                  No messages yet.
                </p>
                <p style="font-size:var(--fs-xs);">
                  Start the conversation with your project team.
                </p>
              </div>

            <% } %>

          </div>


          <!-- MESSAGE COMPOSER -->
          <div style="padding:var(--sp-4) var(--sp-5);border-top:1px solid var(--clr-border);background:var(--clr-bg-subtle);flex-shrink:0;">

            <form class="d-flex gap-3"
              method="POST"
              action="/messages/<%= activeConversation._id %>">

              <input
                type="text"
                name="content"
                class="form-control"
                placeholder="Type your project message..."
                maxlength="5000"
                autocomplete="off"
                style="flex:1;"
                aria-label="Message content"
                required
              />

              <button type="submit" class="btn btn-primary">
                Send
              </button>

            </form>

          </div>

        <% } else { %>

          <!-- NO CONVERSATION SELECTED -->
          <div style="flex:1;display:flex;align-items:center;justify-content:center;text-align:center;padding:var(--sp-6);">

            <div>
              <h3 style="font-size:var(--fs-lg);">
                Project Messages
              </h3>

              <p class="text-muted" style="font-size:var(--fs-sm);">
                Select a project conversation to view messages.
              </p>
            </div>

          </div>

        <% } %>

      </div>

    </div>

  </div>
</section>

<%- include('../partials/footer') %>
