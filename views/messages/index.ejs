<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     PROJECT MESSAGING — SkillBridge
══════════════════════════════════════════════════════════ -->

<section class="section" style="padding-top: var(--sp-6);">
  <div class="section-container" style="max-width: 1140px;">

    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Project Messaging</span>
    </nav>

    <!-- Two-pane messaging layout -->
    <div class="card" style="display: grid; grid-template-columns: 280px 1fr; padding: 0; overflow: hidden; height: calc(100vh - 180px); min-height: 500px;">

      <!-- Left: Conversation List -->
      <aside style="border-right: 1px solid var(--clr-border); background: var(--clr-bg-subtle); display: flex; flex-direction: column; overflow: hidden;">
        <div style="padding: var(--sp-4) var(--sp-5); border-bottom: 1px solid var(--clr-border); background: var(--clr-surface);">
          <strong style="font-size: var(--fs-sm); color: var(--clr-text);">
            Messages
            <% if (typeof conversations !== 'undefined' && conversations) { %>
              <span class="text-muted" style="font-weight: 400;">(<%= conversations.length %>)</span>
            <% } %>
          </strong>
        </div>

        <div style="overflow-y: auto; flex: 1;">
          <% if (typeof conversations !== 'undefined' && conversations && conversations.length > 0) { %>
            <% conversations.forEach((conv, i) => { %>
              <div
                style="padding: var(--sp-4) var(--sp-5); border-bottom: 1px solid var(--clr-border); cursor: pointer; <%= i === 0 ? 'background: var(--clr-surface);' : '' %> transition: background var(--transition-fast);"
                onmouseover="this.style.background='var(--clr-surface-hover)'"
                onmouseout="this.style.background='<%= i === 0 ? 'var(--clr-surface)' : 'transparent' %>'"
              >
                <div class="d-flex justify-between align-center mb-1">
                  <strong style="font-size: var(--fs-xs); color: var(--clr-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 160px;">
                    <%= conv.projectTitle || 'Project Chat' %>
                  </strong>
                  <span class="text-muted" style="font-size: 0.65rem; flex-shrink: 0; margin-left: var(--sp-2);">
                    <%= conv.lastMessageTime || 'Recently' %>
                  </span>
                </div>
                <div class="text-secondary" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <%= conv.lastMessage || 'No messages yet.' %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <!-- Sample conversations (static preview) -->
            <div style="padding: var(--sp-4) var(--sp-5); border-bottom: 1px solid var(--clr-border); background: var(--clr-surface); cursor: pointer;">
              <div class="d-flex justify-between align-center mb-1">
                <strong style="font-size: var(--fs-xs);">Placement Engine</strong>
                <span class="text-muted" style="font-size: 0.65rem;">11:42 AM</span>
              </div>
              <div class="text-secondary" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                Karthik (Mentor): Code looks clean. Merging PR #4.
              </div>
            </div>
            <div style="padding: var(--sp-4) var(--sp-5); border-bottom: 1px solid var(--clr-border); cursor: pointer;">
              <div class="d-flex justify-between align-center mb-1">
                <strong style="font-size: var(--fs-xs);">GraphQL Microservice</strong>
                <span class="text-muted" style="font-size: 0.65rem;">Yesterday</span>
              </div>
              <div class="text-secondary" style="font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                Divya (Mentor): Check the Redis key TTL settings.
              </div>
            </div>
          <% } %>
        </div>
      </aside>

      <!-- Right: Active Thread -->
      <div style="display: flex; flex-direction: column; background: var(--clr-surface); overflow: hidden;">

        <!-- Thread Header -->
        <div style="padding: var(--sp-4) var(--sp-6); border-bottom: 1px solid var(--clr-border); display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; background: var(--clr-surface);">
          <div>
            <strong style="font-size: var(--fs-base); color: var(--clr-text);">
              <% if (typeof activeConversation !== 'undefined' && activeConversation) { %>
                <%= activeConversation.projectTitle %>
              <% } else { %>
                Campus Placement Assessment Engine
              <% } %>
            </strong>
            <div class="text-muted" style="font-size: var(--fs-xs);">
              <% if (typeof activeConversation !== 'undefined' && activeConversation) { %>
                <%= activeConversation.participantNames || 'Project participants' %>
              <% } else { %>
                Karthik Subramaniam (Alumni Mentor) &amp; You (Student)
              <% } %>
            </div>
          </div>
          <a href="/projects/tasks" class="btn btn-sm btn-secondary">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            Task Board
          </a>
        </div>

        <!-- Chat Stream -->
        <div style="flex: 1; padding: var(--sp-6); overflow-y: auto; display: flex; flex-direction: column; gap: var(--sp-4);">

          <% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
            <% messages.forEach(msg => { %>
              <% const isOwnMessage = currentUser && msg.senderId && msg.senderId.toString() === currentUser._id.toString(); %>
              <div style="max-width: 72%; align-self: <%= isOwnMessage ? 'flex-end' : 'flex-start' %>;">
                <div style="font-size: 0.7rem; color: var(--clr-text-muted); margin-bottom: 3px; text-align: <%= isOwnMessage ? 'right' : 'left' %>;">
                  <%= msg.senderName %> · <%= new Date(msg.createdAt).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %>
                </div>
                <div style="background: <%= isOwnMessage ? 'var(--clr-primary-light)' : 'var(--clr-surface-elevated)' %>; border: 1px solid <%= isOwnMessage ? 'var(--clr-primary-border)' : 'var(--clr-border)' %>; padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-lg); font-size: var(--fs-sm); line-height: 1.6; color: var(--clr-text);">
                  <%= msg.content %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <!-- Static sample messages -->
            <div style="max-width: 72%; align-self: flex-start;">
              <div style="font-size: 0.7rem; color: var(--clr-text-muted); margin-bottom: 3px;">
                Karthik Subramaniam (Mentor) · Oct 28, 10:15 AM
              </div>
              <div style="background: var(--clr-surface-elevated); border: 1px solid var(--clr-border); padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-lg); font-size: var(--fs-sm); line-height: 1.6;">
                Hi Hari, I reviewed the Docker compose configuration. Make sure to mount the test fixture volumes as read-only (<code>:ro</code>) so the evaluated student code cannot overwrite test cases.
              </div>
            </div>
            <div style="max-width: 72%; align-self: flex-end;">
              <div style="font-size: 0.7rem; color: var(--clr-text-muted); margin-bottom: 3px; text-align: right;">
                You (Student) · Oct 28, 10:48 AM
              </div>
              <div style="background: var(--clr-primary-light); border: 1px solid var(--clr-primary-border); padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-lg); font-size: var(--fs-sm); line-height: 1.6;">
                Got it! I just updated the Dockerode container spawn options to use <code>Binds: ['/fixtures:/fixtures:ro']</code> and tested it — threw permission denied as expected.
              </div>
            </div>
            <div style="max-width: 72%; align-self: flex-start;">
              <div style="font-size: 0.7rem; color: var(--clr-text-muted); margin-bottom: 3px;">
                Karthik Subramaniam (Mentor) · Today, 11:42 AM
              </div>
              <div style="background: var(--clr-surface-elevated); border: 1px solid var(--clr-border); padding: var(--sp-3) var(--sp-4); border-radius: var(--radius-lg); font-size: var(--fs-sm); line-height: 1.6;">
                Code looks clean. Merging PR #4 now. Let's start on the memory profiler milestone next.
              </div>
            </div>
          <% } %>
        </div>

        <!-- Message Composer -->
        <div style="padding: var(--sp-4) var(--sp-5); border-top: 1px solid var(--clr-border); background: var(--clr-bg-subtle); flex-shrink: 0;">
          <form class="d-flex gap-3" method="POST" action="/messages">
            <input
              type="text"
              name="content"
              class="form-control"
              placeholder="Type your project message..."
              style="flex: 1;"
              aria-label="Message content"
              required
            />
            <button type="submit" class="btn btn-primary">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
              Send
            </button>
          </form>
        </div>

      </div>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>