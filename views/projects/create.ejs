<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     CREATE / POST PROJECT — SkillBridge
     Charcoal-Black & Slate-Gray Monochrome Interface
══════════════════════════════════════════════════════════ -->

<div class="dashboard-layout">

  <!-- ── Sidebar ────────────────────────────────────────── -->
  <aside class="sidebar">
    <div>
      <div class="sidebar-heading">Alumni Portal</div>
      <nav class="sidebar-nav" aria-label="Alumni navigation">
        <a href="/alumni/dashboard" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Overview
        </a>
        <a href="/projects/create" class="sidebar-link active">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Post Project
        </a>
        <a href="/alumni/proposals" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          Review Proposals
        </a>
        <a href="/messages" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Mentee Messages
        </a>
        <a href="/reviews" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Student Endorsements
        </a>
        <a href="/alumni/profile" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          Alumni Profile
        </a>
      </nav>
    </div>
  </aside>

  <!-- ── Main Form Content ──────────────────────────────── -->
  <main class="dashboard-main">

    <div class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/alumni/dashboard">Alumni</a>
      <span>/</span>
      <span>Post Project</span>
    </div>

    <div class="dashboard-header">
      <div>
        <h1>Post a New MCA Collaboration Project</h1>
        <p>Outline real production tasks from your professional experience to mentor current MCA students.</p>
      </div>
      <div>
        <a href="/alumni/dashboard" class="btn btn-secondary">Cancel &amp; Return</a>
      </div>
    </div>

    <div class="auth-form-card" style="max-width: 820px; margin: 0 auto;">
      
      <form action="/projects" method="POST" novalidate>
        
        <!-- Section 1: Overview -->
        <fieldset class="form-section">
          <legend class="form-section-title">
            <span class="section-num">1</span> Project Overview
          </legend>

          <div class="form-group">
            <label class="form-label" for="projectTitle">
              Project Title <span class="required">*</span>
            </label>
            <input
              type="text"
              id="projectTitle"
              name="title"
              class="form-control"
              placeholder="e.g. Distributed Telemetry Pipeline with Kafka & Go"
              required
            />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="projectCategory">
                Primary Technical Category <span class="required">*</span>
              </label>
              <select id="projectCategory" name="category" class="form-control" required>
                <option value="" disabled selected>— Select Category —</option>
                <option value="web">Full-Stack Web Development</option>
                <option value="cloud">Cloud Infrastructure &amp; DevOps</option>
                <option value="mobile">Mobile Systems (iOS/Android)</option>
                <option value="data">Data Engineering &amp; ML</option>
                <option value="systems">Systems &amp; Network Programming</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="projectDuration">
                Estimated Timeline <span class="required">*</span>
              </label>
              <select id="projectDuration" name="duration" class="form-control" required>
                <option value="" disabled selected>— Select Duration —</option>
                <option value="2-3">2–3 Weeks (Focused Sprint)</option>
                <option value="4-6">4–6 Weeks (Standard Capstone)</option>
                <option value="8+">8+ Weeks (Comprehensive System)</option>
              </select>
            </div>
          </div>
        </fieldset>

        <!-- Section 2: Detailed Scope -->
        <fieldset class="form-section">
          <legend class="form-section-title">
            <span class="section-num">2</span> Technical Scope &amp; Deliverables
          </legend>

          <div class="form-group">
            <label class="form-label" for="projectDescription">
              Detailed Scope &amp; Problem Statement <span class="required">*</span>
            </label>
            <textarea
              id="projectDescription"
              name="description"
              rows="6"
              class="form-control"
              placeholder="Describe the production context, architecture requirements, and goals for the student..."
              required
            ></textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="projectSkills">
              Required Skills &amp; Tech Stack (comma separated) <span class="required">*</span>
            </label>
            <input
              type="text"
              id="projectSkills"
              name="skills"
              class="form-control"
              placeholder="e.g. Node.js, Docker, PostgreSQL, Redis, Jest"
              required
            />
            <span class="form-hint">Students filter projects by these tags.</span>
          </div>
        </fieldset>

        <!-- Section 3: Mentorship Setup -->
        <fieldset class="form-section">
          <legend class="form-section-title">
            <span class="section-num">3</span> Mentorship Cadence
          </legend>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="cadence">Check-in Rhythm <span class="required">*</span></label>
              <select id="cadence" name="cadence" class="form-control" required>
                <option value="weekly">Weekly Virtual Code Review</option>
                <option value="biweekly">Bi-weekly Check-in &amp; PR reviews</option>
                <option value="async">Async GitHub PR comments &amp; Chat</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="maxStudents">Max Student Collaborators</label>
              <input type="number" id="maxStudents" name="maxStudents" class="form-control" value="1" min="1" max="3" />
            </div>
          </div>
        </fieldset>

        <div class="d-flex justify-between align-center mt-6">
          <a href="/alumni/dashboard" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary btn-lg">Publish Project to Students</button>
        </div>

      </form>

    </div>

  </main>
</div>

<%- include('../partials/footer') %>

