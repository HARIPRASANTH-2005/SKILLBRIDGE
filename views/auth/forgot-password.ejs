<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     FORGOT PASSWORD PAGE — SkillBridge
══════════════════════════════════════════════════════════ -->

<section class="auth-page" style="display: flex; align-items: center; justify-content: center; padding: var(--sp-12) var(--sp-6);">
  <div class="auth-form-card" style="max-width: 460px;">
    
    <div class="auth-form-header">
      <div class="login-icon" aria-hidden="true">🔑</div>
      <h1>Reset Password</h1>
      <p>Enter your verified PSG Tech MCA email address to receive password reset instructions.</p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="flash flash-success" role="alert">
        <span>✓</span>
        <div><%= success %></div>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash-error" role="alert">
        <span>⚠️</span>
        <div><%= error %></div>
      </div>
    <% } %>

    <form action="/forgot-password" method="POST" novalidate>
      <div class="form-group">
        <label class="form-label" for="resetEmail">
          Registered Email Address <span class="required">*</span>
        </label>
        <input
          type="email"
          id="resetEmail"
          name="email"
          class="form-control"
          placeholder="your.email@psgtech.ac.in"
          required
        />
        <span class="form-hint">A secure one-time reset link will be sent if an approved account matches.</span>
      </div>

      <button type="submit" class="btn btn-primary btn-submit w-100">
        Send Reset Link
      </button>

      <div class="auth-switch-text mt-4">
        Remembered your password?
        <a href="/login" class="link">Return to Sign In →</a>
      </div>
    </form>

  </div>
</section>

<%- include('../partials/footer') %>

