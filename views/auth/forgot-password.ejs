<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     FORGOT PASSWORD PAGE — SkillBridge
══════════════════════════════════════════════════════════ -->

<section class="auth-page" style="display: flex; align-items: center; justify-content: center; padding: var(--sp-12) var(--sp-6);">
  <div class="auth-form-card" style="max-width: 460px;">
    
    <div class="auth-form-header">
      <div class="login-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
      </div>
      <h1>Reset Password</h1>
      <p>Enter your verified PSG Tech MCA email address to receive password reset instructions.</p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="flash flash-success" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
        <div><%= success %></div>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash-error" role="alert">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <div><%= error %></div>
      </div>
    <% } %>

    <form action="/forgot-password" method="POST" novalidate>
      <div class="form-group">
        <label class="form-label" for="resetEmail">
          Registered Email Address <span class="required">*</span>
        </label>
        <input
          type="email"
          id="resetEmail"
          name="email"
          class="form-control"
          placeholder="your.email@psgtech.ac.in"
          required
        />
        <span class="form-hint">A secure one-time reset link will be sent if an approved account matches.</span>
      </div>

      <button type="submit" class="btn btn-primary btn-submit w-100">
        Send Reset Link
      </button>

      <div class="auth-switch-text mt-4">
        Remembered your password?
        <a href="/login" class="link">Return to Sign In →</a>
      </div>
    </form>

  </div>
</section>

<%- include('../partials/footer') %>

