<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     REVIEWS & FEEDBACK — SkillBridge
     Charcoal-Black & Slate-Gray Monochrome Interface
══════════════════════════════════════════════════════════ -->

<section class="section" style="padding-top: var(--sp-12);">
  <div class="section-container" style="max-width: 960px;">

    <div class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <span>Feedback &amp; Reviews</span>
    </div>

    <div class="dashboard-header">
      <div>
        <h1>Verified Project Reviews &amp; Endorsements</h1>
        <p>Authentic feedback from completed alumni-student collaborations on SkillBridge.</p>
      </div>
      <div>
        <a href="/projects" class="btn btn-primary">Find More Projects</a>
      </div>
    </div>

    <!-- Rating Summary Metrics -->
    <div class="metrics-grid mb-8">
      <div class="metric-card">
        <div class="metric-title">Average Endorsement</div>
        <div class="metric-value">4.9 <span style="font-size: 1rem; color: var(--clr-text-muted);">/ 5.0</span></div>
        <div class="metric-sub">Across verified deliverables</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Code Quality Rating</div>
        <div class="metric-value">98%</div>
        <div class="metric-sub">Unit test &amp; linting compliance</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Milestone Completion</div>
        <div class="metric-value">94%</div>
        <div class="metric-sub">Delivered within agreed scope</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Institutional Standing</div>
        <div class="metric-value">PSG Tech</div>
        <div class="metric-sub">MCA Department Endorsement</div>
      </div>
    </div>

    <!-- Review Cards Feed -->
    <div class="d-flex flex-wrap gap-6" style="flex-direction: column;">

      <!-- Review 1 -->
      <div class="card">
        <div class="d-flex justify-between align-center mb-3 flex-wrap gap-2">
          <div>
            <span class="badge badge-approved">VERIFIED DELIVERABLE</span>
            <h3 style="font-size: var(--fs-lg); margin-top: 4px;">College Attendance Management API</h3>
          </div>
          <div class="text-muted" style="font-size: var(--fs-xs);">Completed Oct 18, 2026</div>
        </div>

        <div style="background: var(--clr-bg-subtle); border: 1px solid var(--clr-border); border-radius: var(--radius-md); padding: var(--sp-4); margin-bottom: var(--sp-4);">
          <div class="d-flex justify-between align-center mb-2">
            <div>
              <strong style="color: var(--clr-text);">Alumni Reviewer: Arvind Ramanathan</strong>
              <div class="text-muted" style="font-size: var(--fs-xs);">Class of 2017 · Lead Architect at Zoho</div>
            </div>
            <div style="font-size: var(--fs-sm); font-weight: 700; color: var(--clr-text);">
              Rating: ★★★★★ (5.0)
            </div>
          </div>
          <p class="text-secondary" style="font-size: var(--fs-sm); line-height: 1.7;">
            "Hari did a phenomenal job structuring the REST API with Express.js and PostgreSQL. He wrote comprehensive integration tests with Supertest and handled edge cases around concurrent teacher attendance marks with database transactions. Great communicator and very responsive to code review comments."
          </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
          <span class="tag">Node.js</span>
          <span class="tag">PostgreSQL</span>
          <span class="tag">Supertest</span>
          <span class="tag">JWT Auth</span>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="card">
        <div class="d-flex justify-between align-center mb-3 flex-wrap gap-2">
          <div>
            <span class="badge badge-approved">VERIFIED DELIVERABLE</span>
            <h3 style="font-size: var(--fs-lg); margin-top: 4px;">E-Commerce GraphQL Schema &amp; Prisma Migration</h3>
          </div>
          <div class="text-muted" style="font-size: var(--fs-xs);">Completed Oct 24, 2026</div>
        </div>

        <div style="background: var(--clr-bg-subtle); border: 1px solid var(--clr-border); border-radius: var(--radius-md); padding: var(--sp-4); margin-bottom: var(--sp-4);">
          <div class="d-flex justify-between align-center mb-2">
            <div>
              <strong style="color: var(--clr-text);">Alumni Reviewer: Divya Swaminathan</strong>
              <div class="text-muted" style="font-size: var(--fs-xs);">Class of 2016 · Staff Software Engineer</div>
            </div>
            <div style="font-size: var(--fs-sm); font-weight: 700; color: var(--clr-text);">
              Rating: ★★★★★ (4.8)
            </div>
          </div>
          <p class="text-secondary" style="font-size: var(--fs-sm); line-height: 1.7;">
            "Clean schema separation and thoughtful relational model design with Prisma ORM. Successfully implemented pagination and relation resolution filters. Excited to see Milestone 2 completed!"
          </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">
          <span class="tag">GraphQL</span>
          <span class="tag">Prisma ORM</span>
          <span class="tag">PostgreSQL</span>
        </div>
      </div>

    </div>

  </div>
</section>

<%- include('../partials/footer') %>

