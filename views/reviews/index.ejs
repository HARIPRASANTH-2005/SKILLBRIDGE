<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     REVIEWS & FEEDBACK — SkillBridge
══════════════════════════════════════════════════════════ -->

<section class="section" style="padding-top: var(--sp-12);">
  <div class="section-container" style="max-width: 960px;">

    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Feedback &amp; Reviews</span>
    </nav>

    <div class="dashboard-header">
      <div>
        <h1>Project Reviews &amp; Endorsements</h1>
        <p>Authentic feedback from completed alumni-student collaborations on SkillBridge.</p>
      </div>
      <div>
        <a href="/projects" class="btn btn-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          Find Projects
        </a>
      </div>
    </div>

    <!-- Summary Metrics -->
    <div class="metrics-grid mb-8">
      <div class="metric-card">
        <div class="metric-title">Average Rating</div>
        <div class="metric-value">4.9 <span style="font-size: 1rem; color: var(--clr-text-muted);">/ 5.0</span></div>
        <div class="metric-sub">Across verified deliverables</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Code Quality</div>
        <div class="metric-value">98%</div>
        <div class="metric-sub">Unit test &amp; linting compliance</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Milestone Rate</div>
        <div class="metric-value">94%</div>
        <div class="metric-sub">Delivered within agreed scope</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Institution</div>
        <div class="metric-value">PSG Tech</div>
        <div class="metric-sub">MCA Department verified</div>
      </div>
    </div>

    <!-- Review Feed -->
    <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
      <div class="d-flex flex-wrap gap-6" style="flex-direction: column;">
        <% reviews.forEach(review => { %>
          <div class="card">
            <div class="d-flex justify-between align-center mb-3 flex-wrap gap-2">
              <div>
                <span class="badge badge-approved">VERIFIED DELIVERABLE</span>
                <h3 style="font-size: var(--fs-lg); margin-top: var(--sp-1);"><%= review.projectTitle || 'Project' %></h3>
              </div>
              <div class="text-muted" style="font-size: var(--fs-xs);">
                <%= review.completedAt ? new Date(review.completedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Recently completed' %>
              </div>
            </div>

            <div style="background: var(--clr-bg-subtle); border: 1px solid var(--clr-border); border-radius: var(--radius-md); padding: var(--sp-4); margin-bottom: var(--sp-4);">
              <div class="d-flex justify-between align-center mb-2 flex-wrap gap-2">
                <div>
                  <strong style="color: var(--clr-text);">
                    <% if (review.reviewerRole === 'alumni') { %>Alumni Reviewer:<% } else { %>Mentor:<% } %>
                    <%= review.reviewerName || 'Mentor' %>
                  </strong>
                  <% if (review.reviewerBatch || review.reviewerCompany) { %>
                    <div class="text-muted" style="font-size: var(--fs-xs);">
                      <% if (review.reviewerBatch) { %>Class of <%= review.reviewerBatch %><% } %>
                      <% if (review.reviewerCompany) { %> · <%= review.reviewerCompany %><% } %>
                    </div>
                  <% } %>
                </div>
                <% if (review.rating) { %>
                  <div style="font-size: var(--fs-sm); font-weight: 700; color: var(--clr-text);">
                    Rating: <%= '★'.repeat(Math.round(review.rating)) %><%= '☆'.repeat(5 - Math.round(review.rating)) %> (<%= review.rating.toFixed(1) %>)
                  </div>
                <% } %>
              </div>
              <% if (review.comment) { %>
                <p class="text-secondary" style="font-size: var(--fs-sm); line-height: 1.7; margin: 0;">
                  "<%= review.comment %>"
                </p>
              <% } %>
            </div>

            <% if (review.skills && review.skills.length > 0) { %>
              <div class="d-flex gap-2 flex-wrap">
                <% review.skills.forEach(sk => { %>
                  <span class="tag"><%= sk %></span>
                <% }) %>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>

    <% } else { %>
      <!-- Static showcase reviews while DB is empty -->
      <div class="d-flex flex-wrap gap-6" style="flex-direction: column;">

        <div class="card">
          <div class="d-flex justify-between align-center mb-3 flex-wrap gap-2">
            <div>
              <span class="badge badge-approved">VERIFIED DELIVERABLE</span>
              <h3 style="font-size: var(--fs-lg); margin-top: var(--sp-1);">College Attendance Management API</h3>
            </div>
            <div class="text-muted" style="font-size: var(--fs-xs);">Completed Oct 18, 2026</div>
          </div>
          <div style="background: var(--clr-bg-subtle); border: 1px solid var(--clr-border); border-radius: var(--radius-md); padding: var(--sp-4); margin-bottom: var(--sp-4);">
            <div class="d-flex justify-between align-center mb-2">
              <div>
                <strong style="color: var(--clr-text);">Alumni Reviewer: Arvind Ramanathan</strong>
                <div class="text-muted" style="font-size: var(--fs-xs);">Class of 2017 · Lead Architect at Zoho</div>
              </div>
              <div style="font-size: var(--fs-sm); font-weight: 700; color: var(--clr-text);">★★★★★ (5.0)</div>
            </div>
            <p class="text-secondary" style="font-size: var(--fs-sm); line-height: 1.7; margin: 0;">
              "Hari did a phenomenal job structuring the REST API with Express.js and PostgreSQL. He wrote comprehensive integration tests with Supertest and handled edge cases around concurrent teacher attendance marks with database transactions. Great communicator and very responsive to code review comments."
            </p>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <span class="tag">Node.js</span>
            <span class="tag">PostgreSQL</span>
            <span class="tag">Supertest</span>
            <span class="tag">JWT Auth</span>
          </div>
        </div>

        <div class="card">
          <div class="d-flex justify-between align-center mb-3 flex-wrap gap-2">
            <div>
              <span class="badge badge-approved">VERIFIED DELIVERABLE</span>
              <h3 style="font-size: var(--fs-lg); margin-top: var(--sp-1);">E-Commerce GraphQL Schema &amp; Prisma Migration</h3>
            </div>
            <div class="text-muted" style="font-size: var(--fs-xs);">Completed Oct 24, 2026</div>
          </div>
          <div style="background: var(--clr-bg-subtle); border: 1px solid var(--clr-border); border-radius: var(--radius-md); padding: var(--sp-4); margin-bottom: var(--sp-4);">
            <div class="d-flex justify-between align-center mb-2">
              <div>
                <strong style="color: var(--clr-text);">Alumni Reviewer: Divya Swaminathan</strong>
                <div class="text-muted" style="font-size: var(--fs-xs);">Class of 2016 · Staff Software Engineer</div>
              </div>
              <div style="font-size: var(--fs-sm); font-weight: 700; color: var(--clr-text);">★★★★★ (4.8)</div>
            </div>
            <p class="text-secondary" style="font-size: var(--fs-sm); line-height: 1.7; margin: 0;">
              "Clean schema separation and thoughtful relational model design with Prisma ORM. Successfully implemented pagination and relation resolution filters. Excited to see Milestone 2 completed!"
            </p>
          </div>
          <div class="d-flex gap-2 flex-wrap">
            <span class="tag">GraphQL</span>
            <span class="tag">Prisma ORM</span>
            <span class="tag">PostgreSQL</span>
          </div>
        </div>

      </div>
    <% } %>

  </div>
</section>

<%- include('../partials/footer') %>