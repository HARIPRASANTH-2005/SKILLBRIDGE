<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     APPLICANT VERIFICATION DETAIL — SkillBridge Admin
══════════════════════════════════════════════════════════ -->

<div class="dashboard-layout">

  <aside class="sidebar">
    <div>
      <div class="sidebar-heading">Administration</div>
      <nav class="sidebar-nav" aria-label="Admin navigation">
        <a href="/admin/dashboard" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Overview
        </a>
        <a href="/admin/verifications" class="sidebar-link active">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Verifications Queue
        </a>
        <a href="/admin/users" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          User Directory
        </a>
        <a href="/admin/projects" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          Projects &amp; Moderation
        </a>
      </nav>
    </div>
  </aside>

  <div class="dashboard-main">

    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/admin/dashboard">Admin</a>
      <span aria-hidden="true">/</span>
      <a href="/admin/verifications">Verifications</a>
      <span aria-hidden="true">/</span>
      <span><%= applicant.fullName %></span>
    </nav>

    <div class="dashboard-header">
      <div>
        <div class="d-flex align-center gap-2 mb-2">
          <%- include('../partials/trust-badge', { status: applicant.status }) %>
          <span class="tag"><%= applicant.role === 'student' ? 'Current MCA Student' : 'MCA Alumni' %></span>
          <span class="text-muted" style="font-size: var(--fs-xs);">Applied <%= new Date(applicant.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
        </div>
        <h1 style="font-size: var(--fs-2xl);"><%= applicant.fullName %></h1>
        <p>Institutional Verification Review &amp; Academic Identity Audit</p>
      </div>
      <div>
        <a href="/admin/verifications" class="btn btn-secondary">← Back to Queue</a>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="flash flash-error mb-6">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        <div><strong>Action Required:</strong> <%= error %></div>
      </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: var(--sp-6);">

      <!-- Left Column: Details & Document -->
      <div>

        <!-- Academic & Identity Profile -->
        <div class="card mb-6">
          <div class="card-header">
            <h2 class="card-title">Academic &amp; Contact Credentials</h2>
          </div>

          <div class="form-row mb-4">
            <div>
              <span class="text-muted" style="font-size: var(--fs-xs);">MCA Roll Number</span>
              <div style="font-size: var(--fs-base); font-weight: 700; color: var(--clr-text); font-family: monospace;">
                <%= applicant.rollNumber %>
              </div>
            </div>
            <div>
              <span class="text-muted" style="font-size: var(--fs-xs);">Institutional Email</span>
              <div style="font-size: var(--fs-sm); font-weight: 500; color: var(--clr-text);">
                <%= applicant.email %>
              </div>
            </div>
          </div>

          <div class="form-row mb-4">
            <div>
              <span class="text-muted" style="font-size: var(--fs-xs);">Contact Phone</span>
              <div style="font-size: var(--fs-sm); color: var(--clr-text);">
                <%= applicant.mobile || 'Not provided' %>
              </div>
            </div>
            <div>
              <span class="text-muted" style="font-size: var(--fs-xs);">Admission Batch</span>
              <div style="font-size: var(--fs-sm); color: var(--clr-text);">
                <%= applicant.admissionBatch || '—' %>
              </div>
            </div>
          </div>

          <% if (applicant.role === 'student') { %>
            <div class="form-row">
              <div>
                <span class="text-muted" style="font-size: var(--fs-xs);">Current Year</span>
                <div style="font-size: var(--fs-sm); color: var(--clr-text);">
                  <%= applicant.currentYear === '1' ? 'First Year (MCA I)' : (applicant.currentYear === '2' ? 'Second Year (MCA II)' : applicant.currentYear) %>
                </div>
              </div>
              <div>
                <span class="text-muted" style="font-size: var(--fs-xs);">Expected Graduation</span>
                <div style="font-size: var(--fs-sm); color: var(--clr-text);">
                  <%= applicant.expectedGradYear || '—' %>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="form-row mb-4">
              <div>
                <span class="text-muted" style="font-size: var(--fs-xs);">Graduation Year</span>
                <div style="font-size: var(--fs-sm); color: var(--clr-text);">
                  Class of <%= applicant.graduationYear || '—' %>
                </div>
              </div>
              <div>
                <span class="text-muted" style="font-size: var(--fs-xs);">Current Profession</span>
                <div style="font-size: var(--fs-sm); color: var(--clr-text);">
                  <%= applicant.profession || '—' %>
                </div>
              </div>
            </div>
            <div class="form-row">
              <div>
                <span class="text-muted" style="font-size: var(--fs-xs);">Organization / Company</span>
                <div style="font-size: var(--fs-sm); color: var(--clr-text);">
                  <%= applicant.company || '—' %>
                </div>
              </div>
              <div>
                <span class="text-muted" style="font-size: var(--fs-xs);">LinkedIn / Portfolio</span>
                <div style="font-size: var(--fs-sm); color: var(--clr-text);">
                  <% if (applicant.linkedin) { %>
                    <a href="<%= applicant.linkedin %>" target="_blank" rel="noopener" class="link">View Profile ↗</a>
                  <% } else { %>
                    —
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Document Verification Box -->
        <div class="card mb-6">
          <div class="card-header">
            <h2 class="card-title">Uploaded Verification Document</h2>
          </div>

          <% if (applicant.documentFilename) { %>
            <div class="d-flex justify-between align-center flex-wrap gap-4" style="background: var(--clr-bg-subtle); padding: var(--sp-4); border: 1px solid var(--clr-border); border-radius: var(--radius-md);">
              <div class="d-flex align-center gap-3">
                <div style="width: 40px; height: 40px; border-radius: var(--radius-sm); background: var(--clr-surface); border: 1px solid var(--clr-border); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--clr-text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <div>
                  <strong style="font-size: var(--fs-sm); color: var(--clr-text);">
                    <%= applicant.documentOriginalName || applicant.documentFilename %>
                  </strong>
                  <div class="text-muted" style="font-size: var(--fs-xs);">
                    Private Document Vault · <%= applicant.documentMimeType || 'Document' %>
                    <% if (applicant.documentSizeBytes) { %>
                      · <%= (applicant.documentSizeBytes / 1024 / 1024).toFixed(2) %> MB
                    <% } %>
                  </div>
                </div>
              </div>
              <a href="/admin/documents/<%= applicant.documentFilename %>" target="_blank" rel="noopener" class="btn btn-secondary">
                Open Secure Document ↗
              </a>
            </div>
          <% } else { %>
            <div class="flash flash-warning">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <div>
                <strong>No Document Uploaded</strong>
                <span style="display:block; font-size: var(--fs-xs);">This applicant registered without attaching an ID document.</span>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Audit Trail -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">Audit Trail &amp; History</h2>
          </div>

          <% if (applicant.verificationHistory && applicant.verificationHistory.length > 0) { %>
            <div class="table-responsive">
              <table class="table">
                <thead>
                  <tr>
                    <th>Timestamp</th>
                    <th>Decision</th>
                    <th>Reviewer</th>
                    <th>Reason / Notes</th>
                  </tr>
                </thead>
                <tbody>
                  <% applicant.verificationHistory.forEach(h => { %>
                    <tr>
                      <td style="font-size: var(--fs-xs); white-space: nowrap;"><%= new Date(h.timestamp).toLocaleString('en-IN') %></td>
                      <td>
                        <%- include('../partials/trust-badge', { status: h.decision }) %>
                      </td>
                      <td style="font-size: var(--fs-xs); font-weight: 600;"><%= h.reviewerName %></td>
                      <td style="font-size: var(--fs-xs); color: var(--clr-text-secondary);"><%= h.reason || '—' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <p class="text-secondary" style="font-size: var(--fs-sm); margin: 0;">No prior audit decisions recorded. Initial review pending.</p>
          <% } %>
        </div>

      </div>

      <!-- Right Column: Verification Action Panel -->
      <div>
        <div class="card mb-6">
          <div class="card-header">
            <h3 class="card-title" style="font-size: var(--fs-base);">Verification Decision</h3>
          </div>
          <p class="text-secondary" style="font-size: var(--fs-xs); line-height: 1.6; margin-bottom: var(--sp-4);">
            Approving grants verified status — alumni can post projects, students can apply with technical proposals.
          </p>

          <!-- Approve -->
          <form action="/admin/verifications/<%= applicant._id %>/approve" method="POST" class="mb-4">
            <button type="submit" class="btn btn-primary w-100" style="padding: 0.75rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Approve &amp; Verify Account
            </button>
          </form>

          <hr style="border: none; border-top: 1px solid var(--clr-border-subtle); margin: var(--sp-5) 0;" />

          <!-- Reject -->
          <h4 style="font-size: var(--fs-sm); font-weight: 600; margin-bottom: var(--sp-2); color: var(--clr-danger-text);">Decline Verification</h4>
          <p class="text-secondary" style="font-size: var(--fs-xs); margin-bottom: var(--sp-3);">
            Provide a clear institutional reason. This will be recorded in the audit trail and shown to the applicant.
          </p>

          <form action="/admin/verifications/<%= applicant._id %>/reject" method="POST">
            <div class="form-group mb-3">
              <label class="form-label" for="rejectionReason" style="font-size: var(--fs-xs);">
                Rejection Reason <span class="required">*</span>
              </label>
              <textarea
                id="rejectionReason"
                name="reason"
                rows="4"
                class="form-control"
                placeholder="Specify the verification issue (minimum 10 characters)..."
                required
              ><%= applicant.rejectionReason || '' %></textarea>
            </div>

            <button type="submit" class="btn btn-danger w-100">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              Decline Application
            </button>
          </form>
        </div>

        <!-- Checklist -->
        <div class="card">
          <h4 style="font-size: var(--fs-sm); font-weight: 600; margin-bottom: var(--sp-3);">Verification Checklist</h4>
          <ul style="display: flex; flex-direction: column; gap: var(--sp-2);">
            <li style="font-size: var(--fs-xs); display: flex; align-items: flex-start; gap: var(--sp-2); color: var(--clr-text-secondary);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--clr-success-text)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Roll format matches PSG Tech MCA schema (e.g., 24MCA001)
            </li>
            <li style="font-size: var(--fs-xs); display: flex; align-items: flex-start; gap: var(--sp-2); color: var(--clr-text-secondary);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--clr-success-text)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Name matches ID card or provisional degree certificate
            </li>
            <li style="font-size: var(--fs-xs); display: flex; align-items: flex-start; gap: var(--sp-2); color: var(--clr-text-secondary);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--clr-success-text)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Institutional email domain verified
            </li>
            <li style="font-size: var(--fs-xs); display: flex; align-items: flex-start; gap: var(--sp-2); color: var(--clr-text-secondary);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--clr-success-text)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Uploaded document is legible and unexpired
            </li>
          </ul>
        </div>
      </div>

    </div>

  </div>
</div>

<%- include('../partials/footer') %>