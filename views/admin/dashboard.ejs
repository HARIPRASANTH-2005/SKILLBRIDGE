
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<%
  const dashboardStats = stats || {};
  const applicants = Array.isArray(recentPending) ? recentPending : [];

  const pendingCount = dashboardStats.pendingCount || 0;
  const pendingStudents = dashboardStats.pendingStudents || 0;
  const pendingAlumni = dashboardStats.pendingAlumni || 0;
  const verifiedStudents = dashboardStats.verifiedStudents || 0;
  const verifiedAlumni = dashboardStats.verifiedAlumni || 0;
  const activeProjects = dashboardStats.activeProjects || 0;
%>

<!-- ══════════════════════════════════════════════════════════
     ADMIN CONSOLE DASHBOARD — SkillBridge
     Modern Professional SaaS Interface
══════════════════════════════════════════════════════════ -->

<div class="dashboard-layout">

  <!-- ── Sidebar ────────────────────────────────────────── -->
  <aside class="sidebar" aria-label="Admin navigation">
    <div>
      <div class="sidebar-heading">Administration</div>

      <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="sidebar-link active">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          Overview
        </a>

        <a href="/admin/verifications" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          Verifications
          <% if (pendingCount > 0) { %>
            <span class="sidebar-badge"><%= pendingCount %></span>
          <% } %>
        </a>

        <a href="/admin/users" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          User Directory
        </a>

        <a href="/admin/projects" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
          </svg>
          Moderation &amp; Projects
        </a>
      </nav>
    </div>

    <div style="padding: 0 var(--sp-2);">
      <div style="background: var(--clr-primary-light); border: 1px solid var(--clr-primary-border); border-radius: var(--radius-sm); padding: var(--sp-3);">
        <strong style="font-size: var(--fs-xs); color: var(--clr-primary); display: block;">Department Cell</strong>
        <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
          Institutional Oversight
        </div>
      </div>
    </div>
  </aside>

  <!-- ── Main Admin Content ─────────────────────────────── -->
  <div class="dashboard-main">

    <div class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/admin/dashboard">Admin</a>
      <span>/</span>
      <span>Overview</span>
    </div>

    <div class="dashboard-header">
      <div>
        <h1>Administration Overview</h1>
        <p>Institutional oversight for MCA student credentials, alumni verifications, and project integrity.</p>
      </div>

      <div>
        <a href="/admin/verifications" class="btn btn-primary">
          Review Queue (<%= pendingCount %>) →
        </a>
      </div>
    </div>

    <% if (dbUnavailable) { %>
      <div class="alert alert-danger" role="alert">
        Dashboard data could not be loaded because the database is unavailable.
        Please try again later.
      </div>
    <% } %>

    <!-- Administrative Metrics Grid -->
    <div class="metrics-grid">

      <div class="metric-card">
        <div class="metric-title">Pending Verifications</div>
        <div class="metric-value" style="color: var(--clr-warning-text);">
          <%= pendingCount %>
        </div>
        <div class="metric-sub">
          <%= pendingStudents %> Students · <%= pendingAlumni %> Alumni
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-title">Verified Students</div>
        <div class="metric-value"><%= verifiedStudents %></div>
        <div class="metric-sub">Approved student accounts</div>
      </div>

      <div class="metric-card">
        <div class="metric-title">Verified Alumni</div>
        <div class="metric-value"><%= verifiedAlumni %></div>
        <div class="metric-sub">Approved alumni accounts</div>
      </div>

      <div class="metric-card">
        <div class="metric-title">Active Projects</div>
        <div class="metric-value"><%= activeProjects %></div>
        <div class="metric-sub">Open and in-progress projects</div>
      </div>

    </div>

    <!-- Pending Verification Table Preview -->
    <div class="card">

      <div class="card-header">
        <div>
          <h3 class="card-title">Priority Verification Requests</h3>
          <p class="card-subtitle">
            Review institutional ID cards and degree provisional certificates
          </p>
        </div>

        <a href="/admin/verifications" class="btn btn-sm btn-secondary">
          Open Full Queue
        </a>
      </div>

      <div class="table-responsive">
        <table class="table">

          <thead>
            <tr>
              <th>Applicant Name</th>
              <th>Role</th>
              <th>Roll Number</th>
              <th>Proof Document</th>
              <th>Submitted Date</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>

            <% if (applicants.length > 0) { %>

              <% applicants.forEach(applicant => { %>
                <tr>

                  <td>
                    <strong><%= applicant.fullName || 'Name unavailable' %></strong>
                    <div class="text-muted" style="font-size: var(--fs-xs);">
                      <%= applicant.email || 'Email unavailable' %>
                    </div>
                  </td>

                  <td>
                    <span class="tag">
                      <%= applicant.role === 'alumni' ? 'Alumni' : 'Student' %>
                    </span>
                  </td>

                  <td>
                    <%= applicant.rollNumber || '—' %>
                  </td>

                  <td>
                    <% if (applicant.documentFilename) { %>
                      <span class="text-secondary" style="font-size: var(--fs-xs);">
                        <%= applicant.documentOriginalName || applicant.documentFilename %>
                      </span>
                    <% } else { %>
                      <span class="text-muted">Not uploaded</span>
                    <% } %>
                  </td>

                  <td>
                    <% if (applicant.createdAt) { %>
                      <%= new Date(applicant.createdAt).toLocaleString('en-IN', {
                        day: '2-digit',
                        month: 'short',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                      }) %>
                    <% } else { %>
                      —
                    <% } %>
                  </td>

                  <td>
                    <div class="d-flex gap-2">
                      <a
                        href="/admin/verifications/<%= applicant._id %>"
                        class="btn btn-sm btn-primary"
                      >
                        Inspect &amp; Clear
                      </a>
                    </div>
                  </td>

                </tr>
              <% }); %>

            <% } else { %>

              <tr>
                <td colspan="6" style="text-align: center; padding: var(--sp-5);">
                  <strong>No pending verification requests</strong>
                  <div class="text-muted" style="font-size: var(--fs-xs); margin-top: 6px;">
                    New student and alumni applications will appear here.
                  </div>
                </td>
              </tr>

            <% } %>

          </tbody>

        </table>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
