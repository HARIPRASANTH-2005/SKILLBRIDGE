<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     ADMIN USER DIRECTORY — SkillBridge
══════════════════════════════════════════════════════════ -->

<div class="dashboard-layout">

  <aside class="sidebar">
    <div>
      <div class="sidebar-heading">Administration</div>
      <nav class="sidebar-nav" aria-label="Admin navigation">
        <a href="/admin/dashboard" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Overview
        </a>
        <a href="/admin/verifications" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Verifications Queue
          <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
            <span class="sidebar-badge" style="background: var(--clr-warning-bg); color: var(--clr-warning-text); border: 1px solid var(--clr-warning-border);"><%= pendingCount %></span>
          <% } %>
        </a>
        <a href="/admin/users" class="sidebar-link active">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          User Directory
        </a>
        <a href="/admin/projects" class="sidebar-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
          Projects &amp; Moderation
        </a>
      </nav>
    </div>
  </aside>

  <div class="dashboard-main">

    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/admin/dashboard">Admin</a>
      <span aria-hidden="true">/</span>
      <span>User Directory</span>
    </nav>

    <div class="dashboard-header">
      <div>
        <h1>Institutional User Directory</h1>
        <p>Monitor verified students and alumni members across the PSG Tech MCA network.</p>
      </div>
      <div>
        <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
          <a href="/admin/verifications" class="btn btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            Review Pending (<%= pendingCount %>)
          </a>
        <% } else { %>
          <a href="/admin/verifications" class="btn btn-secondary">Verification Queue</a>
        <% } %>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="card mb-6">
      <form method="GET" action="/admin/users" class="d-flex flex-wrap gap-4 align-center">
        <div style="flex: 2; min-width: 240px;">
          <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search by name, roll number, or institutional email..."
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            aria-label="Search users"
          />
        </div>
        <div style="flex: 1; min-width: 140px;">
          <select name="role" class="form-control" aria-label="Filter by role">
            <option value="">All Roles</option>
            <option value="student" <%= (typeof roleFilter !== 'undefined' && roleFilter === 'student') ? 'selected' : '' %>>MCA Students</option>
            <option value="alumni" <%= (typeof roleFilter !== 'undefined' && roleFilter === 'alumni') ? 'selected' : '' %>>MCA Alumni</option>
          </select>
        </div>
        <div style="flex: 1; min-width: 140px;">
          <select name="status" class="form-control" aria-label="Filter by status">
            <option value="">All Statuses</option>
            <option value="approved" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'approved') ? 'selected' : '' %>>Approved</option>
            <option value="pending" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'pending') ? 'selected' : '' %>>Pending</option>
            <option value="rejected" <%= (typeof statusFilter !== 'undefined' && statusFilter === 'rejected') ? 'selected' : '' %>>Rejected</option>
          </select>
        </div>
        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">Filter</button>
          <a href="/admin/users" class="btn btn-secondary">Clear</a>
        </div>
      </form>
    </div>

    <!-- Users Table -->
    <% if (typeof users !== 'undefined' && users && users.length > 0) { %>
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th>User</th>
              <th>Role</th>
              <th>Roll Number</th>
              <th>Batch / Year</th>
              <th>Verification</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <td>
                  <strong><%= user.fullName %></strong>
                  <div class="text-muted" style="font-size: var(--fs-xs);"><%= user.email %></div>
                </td>
                <td><span class="tag" style="text-transform: capitalize;"><%= user.role %></span></td>
                <td><code><%= user.rollNumber || '—' %></code></td>
                <td>
                  <% if (user.role === 'student') { %>
                    MCA <%= user.currentYear === '1' ? 'I' : (user.currentYear === '2' ? 'II' : user.currentYear) %> (<%= user.admissionBatch || '—' %>)
                  <% } else { %>
                    Class of <%= user.graduationYear || '—' %>
                  <% } %>
                </td>
                <td>
                  <span class="badge <%= user.status === 'approved' ? 'badge-approved' : (user.status === 'rejected' ? 'badge-rejected' : 'badge-pending') %>">
                    <%= (user.status || 'pending').toUpperCase() %>
                  </span>
                </td>
                <td>
                  <div class="d-flex gap-2">
                    <% if (user.status === 'pending') { %>
                      <a href="/admin/verifications/<%= user._id %>" class="btn btn-sm btn-primary">Verify</a>
                    <% } else { %>
                      <a href="<%= user.role === 'student' ? '/student/profile' : '/alumni/profile' %>" class="btn btn-sm btn-secondary">Profile</a>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card text-center" style="padding: var(--sp-10) var(--sp-6);">
        <h3 style="font-size: var(--fs-lg); margin-bottom: var(--sp-2);">No Users Found</h3>
        <p class="text-secondary" style="font-size: var(--fs-sm); margin-bottom: var(--sp-4);">
          No users match your current filter criteria.
        </p>
        <a href="/admin/users" class="btn btn-secondary">Clear Filters</a>
      </div>
    <% } %>

  </div>
</div>

<%- include('../partials/footer') %>