<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     PLATFORM ADMINISTRATOR LOGIN — SkillBridge
     Charcoal-Black & Slate-Gray Monochrome Interface
══════════════════════════════════════════════════════════ -->

<section class="auth-page">
  <div class="login-layout">

    <!-- Left: Department Console Info -->
    <div class="auth-left-panel">
      <div>
        <div class="brand-monogram mb-6" style="display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: var(--radius-sm); background: var(--clr-surface-elevated); border: 1px solid var(--clr-border);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h1 style="font-size: var(--fs-2xl); font-weight: 700; margin-bottom: var(--sp-2);">Administration Console</h1>
        <p class="text-secondary" style="font-size: var(--fs-sm); line-height: 1.6; margin-bottom: var(--sp-8);">
          Authorized administrative access for Department of Computer Applications faculty coordinators and verification officers.
        </p>

        <div class="role-card mb-4" style="border: 1px solid var(--clr-border);">
          <h4 style="font-size: var(--fs-sm); font-weight: 600; margin-bottom: var(--sp-2); color: var(--clr-text);">Operational Responsibilities</h4>
          <ul class="role-features">
            <li><span>✓</span> Authenticate MCA roll numbers against college registrar</li>
            <li><span>✓</span> Review student ID cards and alumni provisional degree certificates</li>
            <li><span>✓</span> Audit project proposals and moderation queues</li>
            <li><span>✓</span> Maintain trusted institutional collaboration directory</li>
          </ul>
        </div>
      </div>

      <div class="text-muted" style="font-size: var(--fs-xs);">
        PSG College of Technology · Department of Computer Applications
      </div>
    </div>

    <!-- Right: Sign In Form -->
    <div class="auth-right-panel">
      <div class="auth-form-card">

        <div class="mb-6">
          <span class="badge badge-active mb-2" style="font-size: var(--fs-xs);">ADMINISTRATIVE CLEARANCE</span>
          <h2 style="font-size: var(--fs-2xl); font-weight: 700; margin-bottom: var(--sp-2);">Sign In to Console</h2>
          <p class="text-secondary" style="font-size: var(--fs-sm);">
            Enter your institutional administrator credentials to manage platform verifications.
          </p>
        </div>

        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="doc-info-box mb-6" style="border-color: var(--clr-danger-border); background: var(--clr-danger-bg); color: var(--clr-danger-text);">
            <span>✕</span>
            <div>
              <strong>Authentication Failure</strong>
              <% errors.forEach(e => { %>
                <p style="font-size: var(--fs-xs); margin: 0;"><%= e.msg %></p>
              <% }) %>
            </div>
          </div>
        <% } %>

        <form action="/admin/login" method="POST" novalidate>
          <div class="form-group">
            <label class="form-label" for="adminEmail">
              Administrator Institutional Email <span class="required">*</span>
            </label>
            <input
              type="email"
              id="adminEmail"
              name="email"
              class="form-control"
              placeholder="admin@psgtech.ac.in"
              value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              required
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="adminPassword">
              Console Password <span class="required">*</span>
            </label>
            <input
              type="password"
              id="adminPassword"
              name="password"
              class="form-control"
              placeholder="••••••••••••"
              required
              autocomplete="current-password"
            />
          </div>

          <button type="submit" class="btn btn-primary btn-lg w-100 mb-4">
            Authenticate Administrator
          </button>
        </form>

        <div class="text-center" style="border-top: 1px solid var(--clr-border-subtle); padding-top: var(--sp-4);">
          <span class="text-muted" style="font-size: var(--fs-xs);">Student or Alumni member? </span>
          <a href="/login" class="link" style="font-size: var(--fs-xs); font-weight: 600;">Member Sign In →</a>
        </div>

      </div>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>

