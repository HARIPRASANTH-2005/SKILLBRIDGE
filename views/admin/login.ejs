<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<!-- ══════════════════════════════════════════════════════════
     PLATFORM ADMINISTRATOR LOGIN — SkillBridge
     Deep Teal & Warm White Academic Console Authentication
══════════════════════════════════════════════════════════ -->

<section class="auth-page login-page" aria-labelledby="adminLoginHeading">
  <div class="login-layout">

    <!-- ── Left branding panel ───────────────────────────── -->
    <aside class="auth-panel login-panel" aria-hidden="true">
      <div class="auth-panel-inner">
        <div class="auth-panel-logo">
          <span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </span>
          <span>Skill<strong>Bridge</strong></span>
        </div>
        <h2>Admin Console</h2>
        <p>Authorized access for Department of Computer Applications faculty coordinators and verification officers.</p>

        <div class="login-roles">
          <div class="login-role-item">
            <span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </span>
            <div>
              <strong>Verify Credentials</strong>
              <span>Authenticate student roll numbers and alumni degrees</span>
            </div>
          </div>
          <div class="login-role-item">
            <span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            </span>
            <div>
              <strong>Audit Projects</strong>
              <span>Review technical scopes and ensure student learning standards</span>
            </div>
          </div>
          <div class="login-role-item">
            <span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <div>
              <strong>User Directory</strong>
              <span>Manage active student and alumni collaboration records</span>
            </div>
          </div>
        </div>

        <div class="auth-panel-note">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span>Restricted to authorized PSG College of Technology department staff.</span>
        </div>
      </div>
    </aside>

    <!-- ── Right form panel ──────────────────────────────── -->
    <div class="auth-form-panel">
      <div class="auth-form-card">

        <div class="auth-form-header">
          <span class="badge badge-primary mb-2" style="font-size: var(--fs-xs);">ADMINISTRATIVE CLEARANCE</span>
          <h1 id="adminLoginHeading" style="font-size: var(--fs-2xl); font-weight: 700; margin-bottom: var(--sp-2);">Console Sign In</h1>
          <p class="text-secondary" style="font-size: var(--fs-sm);">
            Enter your institutional administrator credentials to manage platform verifications.
          </p>
        </div>

        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
          <div class="flash flash-error mb-6" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            <div>
              <strong>Authentication Failure</strong>
              <% errors.forEach(e => { %>
                <p style="font-size: var(--fs-xs); margin: 0;"><%= e.msg %></p>
              <% }) %>
            </div>
          </div>
        <% } %>

        <form action="/admin/login" method="POST" novalidate>
          <div class="form-group">
            <label class="form-label" for="adminEmail">
              Administrator Institutional Email <span class="required">*</span>
            </label>
            <input
              type="email"
              id="adminEmail"
              name="email"
              class="form-control"
              placeholder="admin@psgtech.ac.in"
              value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
              required
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="adminPassword">
              Console Password <span class="required">*</span>
            </label>
            <input
              type="password"
              id="adminPassword"
              name="password"
              class="form-control"
              placeholder="••••••••••••"
              required
              autocomplete="current-password"
            />
          </div>

          <button type="submit" class="btn btn-primary btn-lg w-100 mb-4">
            Authenticate Administrator
          </button>
        </form>

        <div class="text-center" style="border-top: 1px solid var(--clr-border-subtle); padding-top: var(--sp-4);">
          <span class="text-muted" style="font-size: var(--fs-xs);">Student or Alumni member? </span>
          <a href="/login" class="link" style="font-size: var(--fs-xs); font-weight: 600;">Member Sign In →</a>
        </div>

      </div>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>