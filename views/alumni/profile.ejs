
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<%
  const profile = alumni || {};
  const stats = profileStats || {};
  const projects = createdProjects || [];
  const verification = latestVerification || null;

  const formatDate = (date) => {
    if (!date) return '—';
    return new Date(date).toLocaleDateString('en-IN', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });
  };

  const statusLabel = (status) => {
    const labels = {
      open: 'Open',
      in_progress: 'In Progress',
      completed: 'Completed',
      archived: 'Archived'
    };
    return labels[status] || status || 'Unknown';
  };

  const statusClass = (status) => {
    const classes = {
      open: 'badge-pending',
      in_progress: 'badge-active',
      completed: 'badge-approved',
      archived: 'badge-secondary'
    };
    return classes[status] || 'badge-secondary';
  };
%>

<div class="dashboard-layout">

  <!-- Sidebar -->
  <aside class="sidebar" aria-label="Alumni navigation">
    <div>
      <div class="sidebar-heading">Alumni Portal</div>

      <nav class="sidebar-nav">
        <a href="/alumni/dashboard" class="sidebar-link">
          Overview
        </a>

        <a href="/projects/create" class="sidebar-link">
          Post Project
        </a>

        <a href="/alumni/proposals" class="sidebar-link">
          Review Proposals
          <% if (stats.pendingProposalCount > 0) { %>
            <span class="sidebar-badge">
              <%= stats.pendingProposalCount %>
            </span>
          <% } %>
        </a>

        <a href="/messages" class="sidebar-link">
          Mentee Messages
        </a>

        <!-- <a href="/reviews" class="sidebar-link">
          Student Endorsements
        </a> -->

        <a href="/alumni/profile" class="sidebar-link active">
          Alumni Profile
        </a>
      </nav>
    </div>

    <div style="padding: 0 var(--sp-2);">
      <div style="background: var(--clr-primary-light); border: 1px solid var(--clr-primary-border); border-radius: var(--radius-sm); padding: var(--sp-3);">
        <strong style="font-size: var(--fs-xs); color: var(--clr-primary); display: block;">
          MCA Alumni Cell
        </strong>
        <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
          Industry Mentorship Network
        </div>
      </div>
    </div>
  </aside>


  <!-- Main Content -->
  <main class="dashboard-main">

    <div class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/alumni/dashboard">Alumni</a>
      <span>/</span>
      <span>Profile</span>
    </div>


    <!-- Header -->
    <div class="dashboard-header">
      <div>
        <h1>Alumni Mentor Profile</h1>
        <p>
          Manage your mentor credentials, professional information
          and technical domains.
        </p>
      </div>

      <div>
        <span class="badge badge-approved"
              style="padding: 0.35rem 0.85rem; font-size: var(--fs-xs);">
          ✓ APPROVED ALUMNI
        </span>
      </div>
    </div>


    
   <!-- Feedback Messages -->
<% if (typeof success !== 'undefined' && success === 'updated') { %>
  <div class="alert alert-success" role="status"
       style="margin-bottom: var(--sp-4);">
    Your profile has been updated successfully.
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger" role="alert"
       style="margin-bottom: var(--sp-4);">
    <%= error %>
  </div>
<% } %>


    <!-- Profile Statistics -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: var(--sp-3); margin-bottom: var(--sp-6);">

      <div class="card">
        <div class="text-muted" style="font-size: var(--fs-xs);">
          Created Projects
        </div>
        <div style="font-size: var(--fs-2xl); font-weight: 700; margin-top: var(--sp-1);">
          <%= stats.projectCount || 0 %>
        </div>
      </div>

      <div class="card">
        <div class="text-muted" style="font-size: var(--fs-xs);">
          Completed Projects
        </div>
        <div style="font-size: var(--fs-2xl); font-weight: 700; margin-top: var(--sp-1);">
          <%= stats.completedProjectCount || 0 %>
        </div>
      </div>

      <div class="card">
        <div class="text-muted" style="font-size: var(--fs-xs);">
          Total Proposals
        </div>
        <div style="font-size: var(--fs-2xl); font-weight: 700; margin-top: var(--sp-1);">
          <%= stats.totalProposalCount || 0 %>
        </div>
      </div>

      <div class="card">
        <div class="text-muted" style="font-size: var(--fs-xs);">
          Pending Proposals
        </div>
        <div style="font-size: var(--fs-2xl); font-weight: 700; margin-top: var(--sp-1);">
          <%= stats.pendingProposalCount || 0 %>
        </div>
      </div>

    </div>


    <!-- Profile Columns -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: var(--sp-6);">


      <!-- LEFT COLUMN -->
      <div class="d-flex flex-column gap-6">

        <!-- Personal and Academic Information -->
        <section class="card" style="height: fit-content;">

          <div class="text-center mb-4">

            <div style="width: 72px; height: 72px; border-radius: 50%; background: var(--clr-primary-light); border: 2px solid var(--clr-primary-border); color: var(--clr-primary); display: flex; align-items: center; justify-content: center; margin: 0 auto var(--sp-3);">

              <svg width="32" height="32" viewBox="0 0 24 24"
                   fill="none" stroke="currentColor"
                   stroke-width="2" stroke-linecap="round"
                   stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="8" r="7"></circle>
                <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
              </svg>

            </div>

            <h2 style="font-size: var(--fs-xl); font-weight: 700;">
              <%= profile.fullName || 'Alumni Name Not Available' %>
            </h2>

            <div class="text-secondary"
                 style="font-size: var(--fs-xs); margin-top: 2px;">
              MCA Roll Number:
              <strong style="color: var(--clr-text);">
                <%= profile.rollNumber || '—' %>
              </strong>
            </div>

            <div class="text-muted" style="font-size: var(--fs-xs);">
              Class of <%= profile.graduationYear || '—' %>
              · PSG College of Technology
            </div>

          </div>


          <div style="border-top: 1px solid var(--clr-border); padding-top: var(--sp-4); margin-bottom: var(--sp-4);">

            <div class="d-flex justify-between mb-2"
                 style="font-size: var(--fs-xs); gap: var(--sp-2);">
              <span class="text-muted">Profession:</span>
              <strong>
                <%= profile.profession || 'Not provided' %>
              </strong>
            </div>

            <div class="d-flex justify-between mb-2"
                 style="font-size: var(--fs-xs); gap: var(--sp-2);">
              <span class="text-muted">Company:</span>
              <strong>
                <%= profile.company || 'Not provided' %>
              </strong>
            </div>

            <div class="d-flex justify-between mb-2"
                 style="font-size: var(--fs-xs); gap: var(--sp-2);">
              <span class="text-muted">Admission Batch:</span>
              <strong>
                <%= profile.admissionBatch || '—' %>
              </strong>
            </div>

            <div class="d-flex justify-between mb-2"
                 style="font-size: var(--fs-xs); gap: var(--sp-2);">
              <span class="text-muted">Email:</span>
              <strong style="overflow-wrap: anywhere;">
                <%= profile.email || '—' %>
              </strong>
            </div>

            <div class="d-flex justify-between mb-2"
                 style="font-size: var(--fs-xs); gap: var(--sp-2);">
              <span class="text-muted">Mobile:</span>
              <strong>
                <%= profile.mobile || 'Not provided' %>
              </strong>
            </div>

          </div>


          <!-- Verification Document -->
          <div style="border-top: 1px solid var(--clr-border); padding-top: var(--sp-4);">

            <div class="text-muted"
                 style="font-size: var(--fs-xs); margin-bottom: var(--sp-2);">
              Submitted Verification Document
            </div>

            <% if (profile.documentOriginalName) { %>

              <div class="doc-info-box"
                   style="margin: 0; padding: var(--sp-2) var(--sp-3); display: flex; align-items: center; gap: var(--sp-2);">

                <svg width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true"
                     style="color: var(--clr-primary);">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                </svg>

                <div style="font-size: var(--fs-xs); overflow-wrap: anywhere;">
                  <strong>
                    <%= profile.documentOriginalName %>
                  </strong>

                  <div class="text-muted" style="font-size: 0.65rem;">
                    <% if (verification && verification.decision === 'approved') { %>
                      Verified
                      <% if (verification.reviewerName) { %>
                        by <%= verification.reviewerName %>
                      <% } %>
                      · <%= formatDate(verification.timestamp) %>
                    <% } else { %>
                      Account approved
                    <% } %>
                  </div>
                </div>

              </div>

            <% } else { %>

              <p class="text-muted" style="font-size: var(--fs-xs);">
                No verification document information is available.
              </p>

            <% } %>

          </div>

        </section>


        <!-- Professional Links -->
        <section class="card">

          <div class="card-header">
            <div>
              <h3 class="card-title">Professional Links</h3>
              <p class="card-subtitle">
                Your professional online presence
              </p>
            </div>
          </div>

          <% if (profile.linkedin) { %>

            <div class="d-flex align-center justify-between"
                 style="gap: var(--sp-2); overflow-wrap: anywhere;">

              <span style="font-size: var(--fs-sm);">
                LinkedIn Profile
              </span>

              <a href="<%= profile.linkedin %>"
                 target="_blank"
                 rel="noopener noreferrer"
                 class="btn btn-sm btn-secondary">
                View Profile
              </a>

            </div>

          <% } else { %>

            <p class="text-muted" style="font-size: var(--fs-sm);">
              No LinkedIn profile added yet.
            </p>

          <% } %>

        </section>

      </div>


      <!-- RIGHT COLUMN -->
      <div class="d-flex flex-column gap-6">


        <!-- Mentorship Skills -->
        <section class="card">

          <div class="card-header">
            <div>
              <h3 class="card-title">Mentorship Focus Domains</h3>
              <p class="card-subtitle">
                Technical specialties offered for student project guidance
              </p>
            </div>
          </div>

          <% if (profile.skills && profile.skills.length > 0) { %>

            <div class="d-flex flex-wrap gap-2">

              <% profile.skills.forEach(skill => { %>
                <span class="tag"><%= skill %></span>
              <% }) %>

            </div>

          <% } else { %>

            <p class="text-muted" style="font-size: var(--fs-sm);">
              No mentorship skills added yet. Use Edit Profile to add
              your technical domains.
            </p>

          <% } %>

        </section>


        <!-- Projects -->
        <section class="card">

          <div class="card-header">
            <div>
              <h3 class="card-title">
                Created Projects (<%= projects.length %>)
              </h3>
              <p class="card-subtitle">
                Projects created and managed by you
              </p>
            </div>
          </div>


          <% if (projects.length > 0) { %>

            <div class="d-flex flex-column gap-3">

              <% projects.forEach(project => { %>

                <article style="padding: var(--sp-4); background: var(--clr-surface-hover); border: 1px solid var(--clr-border); border-radius: var(--radius-md);">

                  <div class="d-flex justify-between align-center"
                       style="gap: var(--sp-2); flex-wrap: wrap;">

                    <strong style="overflow-wrap: anywhere;">
                      <%= project.title %>
                    </strong>

                    <span class="badge <%= statusClass(project.status) %>">
                      <%= statusLabel(project.status) %>
                    </span>

                  </div>


                  <div class="text-muted"
                       style="font-size: var(--fs-xs); margin-top: var(--sp-2);">

                    <%= project.category || 'General' %>
                    · <%= project.duration || 'Duration not specified' %>

                  </div>


                  <% if (project.description) { %>
                    <p class="text-secondary"
                       style="font-size: var(--fs-xs); margin-top: var(--sp-2); line-height: 1.6;">
                      <%= project.description.length > 180
                        ? project.description.substring(0, 180) + '...'
                        : project.description %>
                    </p>
                  <% } %>


                  <% if (project.skills && project.skills.length > 0) { %>
                    <div class="d-flex flex-wrap gap-1"
                         style="margin-top: var(--sp-2);">
                      <% project.skills.forEach(skill => { %>
                        <span class="tag" style="font-size: 10px;">
                          <%= skill %>
                        </span>
                      <% }) %>
                    </div>
                  <% } %>


                  <!-- Proposal statistics -->
                  <div style="border-top: 1px solid var(--clr-border); margin-top: var(--sp-3); padding-top: var(--sp-3);">

                    <div class="d-flex flex-wrap gap-3"
                         style="font-size: var(--fs-xs);">

                      <span>
                        Proposals:
                        <strong>
                          <%= project.proposalStats.total %>
                        </strong>
                      </span>

                      <span>
                        Pending:
                        <strong>
                          <%= project.proposalStats.pending %>
                        </strong>
                      </span>

                      <span>
                        Accepted:
                        <strong>
                          <%= project.proposalStats.accepted %>
                        </strong>
                      </span>

                    </div>


                    <div class="d-flex flex-wrap gap-3"
                         style="font-size: var(--fs-xs); margin-top: var(--sp-2);">

                      <span>
                        Active students:
                        <strong>
                          <%= project.memberStats.active %>
                        </strong>
                      </span>

                      <span>
                        Completed students:
                        <strong>
                          <%= project.memberStats.completed %>
                        </strong>
                      </span>

                    </div>

                  </div>


                  <!-- Actual project members -->
                  <% if (project.members && project.members.length > 0) { %>

                    <div style="border-top: 1px solid var(--clr-border); margin-top: var(--sp-3); padding-top: var(--sp-3);">

                      <div style="font-size: var(--fs-xs); font-weight: 600; margin-bottom: var(--sp-2);">
                        Project Students
                      </div>

                      <div class="d-flex flex-column gap-2">

                        <% project.members.forEach(member => { %>

                          <div class="d-flex justify-between align-center"
                               style="font-size: var(--fs-xs); gap: var(--sp-2);">

                            <span style="overflow-wrap: anywhere;">
                              <strong><%= member.fullName %></strong>
                              <% if (member.rollNumber) { %>
                                · <%= member.rollNumber %>
                              <% } %>
                            </span>

                            <span class="text-muted">
                              <%= member.status === 'active'
                                ? 'Active'
                                : 'Completed' %>
                            </span>

                          </div>

                        <% }) %>

                      </div>

                    </div>

                  <% } else { %>

                    <p class="text-muted"
                       style="font-size: var(--fs-xs); margin-top: var(--sp-3);">
                      No active or completed student memberships yet.
                    </p>

                  <% } %>


                  <div style="margin-top: var(--sp-3);">
                    <a href="/projects/<%= project._id %>/tasks"
                       class="btn btn-sm btn-secondary">
                      View Project Tasks
                    </a>
                  </div>

                </article>

              <% }) %>

            </div>

          <% } else { %>

            <div class="text-center" style="padding: var(--sp-5);">
              <p class="text-muted" style="font-size: var(--fs-sm);">
                You have not created any projects yet.
              </p>

              <a href="/projects/create"
                 class="btn btn-primary btn-sm"
                 style="margin-top: var(--sp-3);">
                Create Your First Project
              </a>
            </div>

          <% } %>

        </section>

      </div>

    </div>


    <!-- Edit Profile Button -->
    <div style="margin-top: var(--sp-6); display: flex; justify-content: flex-end;">
      <button type="button"
              class="btn btn-primary"
              onclick="openAlumniProfileModal()">
        Edit Profile
      </button>
    </div>

  </main>

</div>


<!-- ═══════════════════════════════════════════════════════
     EDIT PROFILE MODAL
═══════════════════════════════════════════════════════ -->

<div id="alumniProfileModal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="alumniEditTitle"
     style="display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.6); padding: 20px; overflow-y: auto;">

  <div class="card"
       style="width: 100%; max-width: 620px; margin: 35px auto; padding: var(--sp-5);">

    <div class="d-flex justify-between align-center"
         style="margin-bottom: var(--sp-4);">

      <div>
        <h2 id="alumniEditTitle" style="font-size: var(--fs-xl);">
          Edit Alumni Profile
        </h2>

        <p class="text-muted" style="font-size: var(--fs-xs);">
          Update your personal and professional information.
        </p>
      </div>

      <button type="button"
              class="btn btn-sm btn-secondary"
              onclick="closeAlumniProfileModal()"
              aria-label="Close edit profile">
        ✕
      </button>

    </div>


    <form action="/alumni/profile/update"
          method="POST"
          id="alumniProfileEditForm">

      <div class="form-group">
        <label class="form-label" for="editFullName">
          Full Name
        </label>

        <input type="text"
               id="editFullName"
               name="fullName"
               class="form-control"
               value="<%= profile.fullName || '' %>"
               minlength="2"
               maxlength="120"
               required>
      </div>


      <div class="form-group">
        <label class="form-label" for="editMobile">
          Mobile Number
        </label>

        <input type="tel"
               id="editMobile"
               name="mobile"
               class="form-control"
               value="<%= profile.mobile || '' %>"
               maxlength="20">
      </div>


      <div class="form-row">

        <div class="form-group">
          <label class="form-label" for="editProfession">
            Profession
          </label>

          <input type="text"
                 id="editProfession"
                 name="profession"
                 class="form-control"
                 value="<%= profile.profession || '' %>"
                 maxlength="120">
        </div>


        <div class="form-group">
          <label class="form-label" for="editCompany">
            Company
          </label>

          <input type="text"
                 id="editCompany"
                 name="company"
                 class="form-control"
                 value="<%= profile.company || '' %>"
                 maxlength="120">
        </div>

      </div>


      <div class="form-group">
        <label class="form-label" for="editLinkedin">
          LinkedIn Profile URL
        </label>

        <input type="url"
               id="editLinkedin"
               name="linkedin"
               class="form-control"
               value="<%= profile.linkedin || '' %>"
               placeholder="https://www.linkedin.com/in/your-profile">
      </div>


      <div class="form-group">
        <label class="form-label" for="editSkills">
          Mentorship Skills / Technical Domains
        </label>

        <textarea id="editSkills"
                  name="skills"
                  class="form-control"
                  rows="4"
                  placeholder="Java, Spring Boot, Cloud Computing, React"><%= (profile.skills || []).join(', ') %></textarea>

        <small class="text-muted">
          Separate each skill with a comma. Maximum 30 skills,
          each up to 50 characters.
        </small>
      </div>


      <div style="border-top: 1px solid var(--clr-border); padding-top: var(--sp-4); margin-top: var(--sp-4);">

        <p class="text-muted"
           style="font-size: var(--fs-xs); margin-bottom: var(--sp-3);">
          Email, MCA roll number, admission batch, graduation year
          and verification information are protected and cannot
          be edited here.
        </p>

        <div class="d-flex justify-between"
             style="gap: var(--sp-2);">

          <button type="button"
                  class="btn btn-secondary"
                  onclick="closeAlumniProfileModal()">
            Cancel
          </button>

          <button type="submit"
                  class="btn btn-primary">
            Save Changes
          </button>

        </div>

      </div>

    </form>

  </div>

</div>


<script>
  const alumniProfileModal =
    document.getElementById('alumniProfileModal');

  function openAlumniProfileModal() {
    alumniProfileModal.style.display = 'block';
    document.body.style.overflow = 'hidden';

    document.getElementById('editFullName').focus();
  }

  function closeAlumniProfileModal() {
    alumniProfileModal.style.display = 'none';
    document.body.style.overflow = '';
  }

  alumniProfileModal.addEventListener('click', function (event) {
    if (event.target === alumniProfileModal) {
      closeAlumniProfileModal();
    }
  });

  document.addEventListener('keydown', function (event) {
    if (
      event.key === 'Escape' &&
      alumniProfileModal.style.display === 'block'
    ) {
      closeAlumniProfileModal();
    }
  });
</script>


<%- include('../partials/footer') %>
