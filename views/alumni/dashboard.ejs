
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<%
  const stats = dashboardStats || {
    projectCount: 0,
    proposalCount: 0,
    pendingProposalCount: 0,
    activeMenteeCount: 0,
    reviewedTaskCount: 0
  };

  const projects = createdProjects || [];
  const proposals = recentProposals || [];

  const statusLabels = {
    open: 'OPEN FOR APPLICANTS',
    in_progress: 'IN PROGRESS',
    completed: 'COMPLETED',
    archived: 'ARCHIVED'
  };
%>

<div class="dashboard-layout">

  <aside class="sidebar" aria-label="Alumni navigation">
    <div>
      <div class="sidebar-heading">Alumni Portal</div>

      <nav class="sidebar-nav">
        <a href="/alumni/dashboard" class="sidebar-link active">
          Overview
        </a>

        <a href="/projects/create" class="sidebar-link">
          Post Project
        </a>

        <a href="/alumni/proposals" class="sidebar-link">
          Review Proposals
          <% if (stats.pendingProposalCount > 0) { %>
            <span class="sidebar-badge">
              <%= stats.pendingProposalCount %>
            </span>
          <% } %>
        </a>

        <a href="/messages" class="sidebar-link">
          Mentee Messages
        </a>

        <!-- <a href="/reviews" class="sidebar-link">
          Student Endorsements
        </a> -->

        <a href="/alumni/profile" class="sidebar-link">
          Alumni Profile
        </a>
      </nav>
    </div>

    <div style="padding: 0 var(--sp-2);">
      <div style="background: var(--clr-primary-light); border: 1px solid var(--clr-primary-border); border-radius: var(--radius-sm); padding: var(--sp-3);">
        <strong style="font-size: var(--fs-xs); color: var(--clr-primary); display: block;">
          MCA Alumni Cell
        </strong>
        <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
          Industry Mentorship Network
        </div>
      </div>
    </div>
  </aside>

  <div class="dashboard-main">

    <div class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/alumni/dashboard">Alumni</a>
      <span>/</span>
      <span>Dashboard</span>
    </div>

    <div class="dashboard-header">
      <div>
        <h1>
          Welcome Back,
          <%= currentUser?.fullName || 'Alumni' %>
        </h1>

        <p>
          <%= currentUser?.profession || 'Alumni Workspace' %>
          <% if (currentUser?.company) { %>
            · <%= currentUser.company %>
          <% } %>
          <% if (currentUser?.graduationYear) { %>
            · Class of <%= currentUser.graduationYear %>
          <% } %>
        </p>
      </div>

      <div class="d-flex gap-2">
        <a href="/projects/create" class="btn btn-primary">
          + Post New Project
        </a>

        <a href="/alumni/proposals" class="btn btn-secondary">
          Review Proposals
          <% if (stats.pendingProposalCount > 0) { %>
            (<%= stats.pendingProposalCount %>)
          <% } %>
        </a>
      </div>
    </div>

    <!-- Dynamic dashboard metrics -->
    <div class="metrics-grid">

      <div class="metric-card">
        <div class="metric-title">Posted Projects</div>
        <div class="metric-value"><%= stats.projectCount %></div>
        <div class="metric-sub">Projects created by you</div>
      </div>

      <div class="metric-card">
        <div class="metric-title">Proposals Received</div>
        <div class="metric-value"><%= stats.proposalCount %></div>
        <div class="metric-sub">
          <%= stats.pendingProposalCount %> awaiting review
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-title">Selected Mentees</div>
        <div class="metric-value"><%= stats.activeMenteeCount %></div>
        <div class="metric-sub">Active project members</div>
      </div>

      <div class="metric-card">
        <div class="metric-title">Milestones Reviewed</div>
        <div class="metric-value"><%= stats.reviewedTaskCount %></div>
        <div class="metric-sub">Tasks approved by you</div>
      </div>

    </div>

    <!-- Projects from MongoDB -->
    <div class="card">

      <div class="card-header">
        <div>
          <h3 class="card-title">Your Posted Projects</h3>
          <p class="card-subtitle">
            Manage your projects and student applications
          </p>
        </div>

        <a href="/projects/create" class="btn btn-sm btn-secondary">
          + Add Project
        </a>
      </div>

      <% if (projects.length > 0) { %>

        <div class="table-responsive">
          <table class="table">

            <thead>
              <tr>
                <th>Project Title</th>
                <th>Status</th>
                <th>Applicants</th>
                <th>Active Mentees</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% projects.forEach(project => { %>

                <tr>
                  <td>
                    <strong><%= project.title %></strong>

                    <% if (project.skills && project.skills.length > 0) { %>
                      <div class="text-muted" style="font-size: var(--fs-xs);">
                        <%= project.skills.join(' · ') %>
                      </div>
                    <% } %>
                  </td>

                  <td>
                    <span class="badge
                      <%= project.status === 'completed'
                        ? 'badge-approved'
                        : project.status === 'open'
                          ? 'badge-pending'
                          : project.status === 'archived'
                            ? 'badge-secondary'
                            : 'badge-active' %>">
                      <%= statusLabels[project.status] || project.status %>
                    </span>
                  </td>

                  <td>
                    <%= project.applicantCount || 0 %>
                  </td>

                  <td>
                    <%= project.activeMenteeCount || 0 %>
                  </td>

                  <td>
                    <div class="d-flex gap-2">

                      <a
                        href="/projects/<%= project._id %>/tasks"
                        class="btn btn-sm btn-secondary">
                        Tasks
                      </a>

                      <a
                        href="/alumni/proposals"
                        class="btn btn-sm btn-ghost">
                        Proposals
                      </a>

                    </div>
                  </td>
                </tr>

              <% }); %>
            </tbody>

          </table>
        </div>

      <% } else { %>

        <div style="padding: 35px 20px; text-align: center;">
          <h3>No Projects Yet</h3>

          <p class="text-muted">
            You haven't created any projects yet.
            Post your first project to start receiving student proposals.
          </p>

          <a href="/projects/create" class="btn btn-primary">
            + Create Your First Project
          </a>
        </div>

      <% } %>

    </div>

    <!-- Actual pending proposals -->
    <div class="card">

      <div class="card-header">
        <div>
          <h3 class="card-title">
            Recent Proposals Awaiting Decision
          </h3>

          <p class="card-subtitle">
            The latest pending student applications for your projects
          </p>
        </div>

        <a href="/alumni/proposals" class="link" style="font-size: var(--fs-xs);">
          View All Proposals →
        </a>
      </div>

      <% if (proposals.length > 0) { %>

        <div class="d-flex flex-column gap-3">

          <% proposals.forEach(proposal => { %>

            <div style="padding: var(--sp-4); background: var(--clr-surface-hover); border: 1px solid var(--clr-border); border-radius: var(--radius-md);">

              <div class="d-flex justify-between align-center mb-2 flex-wrap gap-2">

                <div>
                  <strong style="font-size: var(--fs-sm);">
                    <%= proposal.studentName %>
                  </strong>

                  <% if (proposal.studentRoll) { %>
                    <span class="text-muted" style="font-size: var(--fs-xs);">
                      (<%= proposal.studentRoll %>)
                    </span>
                  <% } %>

                  <div class="text-muted" style="font-size: var(--fs-xs);">
                    Applied for:
                    <strong><%= proposal.projectTitle %></strong>
                  </div>

                  <% if (proposal.submittedAt) { %>
                    <div class="text-muted" style="font-size: var(--fs-xs);">
                      Submitted:
                      <%= new Date(proposal.submittedAt).toLocaleDateString('en-IN') %>
                    </div>
                  <% } %>
                </div>

                <a
                  href="/alumni/proposals"
                  class="btn btn-sm btn-primary">
                  Review Details
                </a>

              </div>

              <% if (proposal.message) { %>
                <p class="text-secondary" style="font-size: var(--fs-xs); line-height: 1.6; margin-bottom: 0;">
                  <%= proposal.message %>
                </p>
              <% } %>

            </div>

          <% }); %>

        </div>

      <% } else { %>

        <div style="padding: 25px 15px; text-align: center;">
          <h3>No Pending Proposals</h3>

          <p class="text-muted">
            There are currently no pending student proposals
            for your projects.
          </p>

          <% if (stats.proposalCount > 0) { %>
            <a href="/alumni/proposals" class="btn btn-secondary">
              View Processed Proposals
            </a>
          <% } %>
        </div>

      <% } %>

    </div>

  </div>
</div>

<%- include('../partials/footer') %>
