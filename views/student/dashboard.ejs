
<%- include('../partials/head', { title: title }) %>
<%- include('../partials/navbar') %>

<%
  // ─────────────────────────────────────────────
  // SAFE DASHBOARD DATA DEFAULTS
  // ─────────────────────────────────────────────

  const student = typeof currentUser !== 'undefined' ? currentUser : {};

  const applications = typeof appliedProjects !== 'undefined' && Array.isArray(appliedProjects)
    ? appliedProjects
    : [];

  const studentTasks = typeof tasks !== 'undefined' && Array.isArray(tasks)
    ? tasks
    : [];

  const studentMemberships = typeof memberships !== 'undefined' && Array.isArray(memberships) ? memberships : [];

  const studentReviews = typeof reviews !== 'undefined' && Array.isArray(reviews)
    ? reviews
    : [];

  const recommendations = typeof recommendedProjects !== 'undefined' && Array.isArray(recommendedProjects)
    ? recommendedProjects
    : [];

  const dashboardStats = typeof stats !== 'undefined' && stats
    ? stats
    : {};

  // Extract proposal records from the existing appliedProjects structure.
  const proposalRecords = applications
    .filter(item => item && item.proposals && item.proposals.length > 0)
    .map(item => ({
      project: item,
      proposal: item.proposals[0]
    }));

  // Calculate fallback metrics.
  const pendingCount = dashboardStats.pendingProposals !== undefined
    ? dashboardStats.pendingProposals
    : proposalRecords.filter(item => item.proposal.status === 'pending').length;

  const totalTasks = dashboardStats.totalTasks !== undefined
    ? dashboardStats.totalTasks
    : studentTasks.length;

  const completedProjects = dashboardStats.completedProjects !== undefined
    ? dashboardStats.completedProjects
    : studentMemberships.filter(item => item.status === 'completed').length;

  const averageRating = dashboardStats.averageRating !== undefined
    ? dashboardStats.averageRating
    : studentReviews.length
      ? studentReviews.reduce((sum, review) => sum + review.rating, 0) / studentReviews.length
      : null;

  const completedTasks = studentTasks.filter(task => task.status === 'completed').length;

  // ─────────────────────────────────────────────
  // DISPLAY HELPERS
  // ─────────────────────────────────────────────

  const formatDate = (date) => {
    if (!date) return 'Not specified';

    const parsedDate = new Date(date);

    if (isNaN(parsedDate.getTime())) return 'Not specified';

    return parsedDate.toLocaleDateString('en-IN', {
      day: 'numeric',
      month: 'short',
      year: 'numeric'
    });
  };

  const proposalBadge = (status) => {
    const badges = {
      pending: 'badge-pending',
      accepted: 'badge-approved',
      declined: 'badge-rejected'
    };

    return badges[status] || 'badge-pending';
  };

  const taskBadge = (status) => {
    const badges = {
      todo: 'badge-pending',
      in_progress: 'badge-active',
      review: 'badge-pending',
      completed: 'badge-approved'
    };

    return badges[status] || 'badge-pending';
  };

  const readableStatus = (status) => {
    const labels = {
      pending: 'PENDING',
      accepted: 'ACCEPTED',
      declined: 'DECLINED',
      todo: 'TO DO',
      in_progress: 'IN PROGRESS',
      review: 'UNDER REVIEW',
      completed: 'COMPLETED'
    };

    return labels[status] || status || 'UNKNOWN';
  };
%>

<!-- ══════════════════════════════════════════════════════════
     STUDENT WORKSPACE DASHBOARD — SkillBridge
     Database-Driven Dashboard
══════════════════════════════════════════════════════════ -->

<div class="dashboard-layout">

  <!-- ── Dashboard Sidebar ──────────────────────────────── -->

  <aside class="sidebar" aria-label="Student navigation">

    <div>
      <div class="sidebar-heading">Workspace</div>

      <nav class="sidebar-nav">

        <a href="/student/dashboard" class="sidebar-link active">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7"/>
            <rect x="14" y="3" width="7" height="7"/>
            <rect x="14" y="14" width="7" height="7"/>
            <rect x="3" y="14" width="7" height="7"/>
          </svg>
          Overview
        </a>

        <a href="/projects" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          Browse Projects
        </a>

        <a href="/student/tasks" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M9 11l3 3L22 4"/>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
          Assigned Tasks
        </a>

        <a href="/messages" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          Project Messages
        </a>

        <a href="/reviews" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          Feedback &amp; Ratings
        </a>

        <a href="/student/profile" class="sidebar-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round" aria-hidden="true">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          Student Profile
        </a>

      </nav>
    </div>

    <div style="padding: 0 var(--sp-2);">
      <div style="background: var(--clr-primary-light); border: 1px solid var(--clr-primary-border); border-radius: var(--radius-sm); padding: var(--sp-3);">
        <strong style="font-size: var(--fs-xs); color: var(--clr-primary); display: block;">
          PSG Tech MCA
        </strong>

        <div class="text-muted" style="font-size: 11px; margin-top: 2px;">
          Student Collaboration Cell
        </div>
      </div>
    </div>

  </aside>

  <!-- ── Main Dashboard Content ─────────────────────────── -->

  <div class="dashboard-main">

    <div class="breadcrumbs">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/student/dashboard">Student</a>
      <span>/</span>
      <span>Overview</span>
    </div>

    <!-- Dashboard Header -->

    <div class="dashboard-header">

      <div>
        <h1>
          Welcome Back, <%= student.fullName || 'MCA Student' %>
        </h1>

        <p>
          Roll No:
          <strong style="color: var(--clr-text);">
            <%= student.rollNumber || 'Not available' %>
          </strong>
          · PSG College of Technology
        </p>
      </div>

      <div class="d-flex gap-2">
        <a href="/projects" class="btn btn-primary">
          Browse Projects →
        </a>

        <a href="/student/profile" class="btn btn-secondary">
          Edit Profile
        </a>
      </div>

    </div>

    <!-- ═══════════════════════════════════════════════════
         DASHBOARD METRICS
    ═══════════════════════════════════════════════════ -->

    <div class="metrics-grid">

      <!-- Pending Applications -->

      <div class="metric-card">
        <div class="metric-title">Pending Proposals</div>

        <div class="metric-value">
          <%= pendingCount %>
        </div>

        <div class="metric-sub">
          Awaiting alumni review
        </div>
      </div>

      <!-- Assigned Tasks -->

      <div class="metric-card">
        <div class="metric-title">Assigned Tasks</div>

        <div class="metric-value">
          <%= totalTasks %>
        </div>

        <div class="metric-sub">
          <%= completedTasks %> completed
        </div>
      </div>

      <!-- Completed Projects -->

      <div class="metric-card">
        <div class="metric-title">Completed Projects</div>

        <div class="metric-value">
          <%= completedProjects %>
        </div>

        <div class="metric-sub">
          Verified project memberships
        </div>
      </div>

      <!-- Endorsement Score -->

      <div class="metric-card">
        <div class="metric-title">Endorsement Score</div>

        <div class="metric-value">
          <% if (averageRating !== null && !isNaN(Number(averageRating))) { %>
            <%= Number(averageRating).toFixed(1) %>
            <span style="font-size: 1rem; color: var(--clr-text-muted);">/5.0</span>
          <% } else { %>
            —
          <% } %>
        </div>

        <div class="metric-sub">
          Based on <%= studentReviews.length %> visible reviews
        </div>
      </div>

    </div>

    <!-- ═══════════════════════════════════════════════════
         APPLICATIONS AND TASKS
    ═══════════════════════════════════════════════════ -->

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: var(--sp-6); margin-bottom: var(--sp-6);">

      <!-- ── Submitted Proposals ───────────────────────── -->

      <div class="card">

        <div class="card-header">
          <h3 class="card-title">Submitted Proposals</h3>

          <a href="/projects" class="link" style="font-size: var(--fs-xs);">
            Find Projects →
          </a>
        </div>

        <div class="d-flex flex-column gap-3">

          <% if (proposalRecords.length > 0) { %>

            <% proposalRecords.slice(0, 4).forEach(item => { %>

              <%
                const project = item.project;
                const proposal = item.proposal;
              %>

              <div style="padding: var(--sp-4); background: var(--clr-surface-hover); border: 1px solid var(--clr-border); border-radius: var(--radius-md);">

                <div class="d-flex justify-between align-center mb-1">

                  <strong style="font-size: var(--fs-sm);">
                    <%= project.title || 'Untitled Project' %>
                  </strong>

                  <span class="badge <%= proposalBadge(proposal.status) %>">
                    <%= readableStatus(proposal.status) %>
                  </span>

                </div>

                <p class="text-secondary" style="font-size: var(--fs-xs); margin-bottom: var(--sp-2);">
                  Mentor:
                  <%= project.creatorName || 'Not available' %>
                </p>

                <div class="d-flex justify-between align-center text-muted" style="font-size: var(--fs-xs);">

                  <span>
                    Submitted: <%= formatDate(proposal.submittedAt) %>
                  </span>

                  <span>
                    <%= project.category || 'General' %>
                  </span>

                </div>

                <% if (project.skills && project.skills.length > 0) { %>
                  <div style="margin-top: var(--sp-2);">
                    <% project.skills.slice(0, 4).forEach(skill => { %>
                      <span class="tag"><%= skill %></span>
                    <% }) %>
                  </div>
                <% } %>

              </div>

            <% }) %>

          <% } else { %>

            <div style="padding: var(--sp-5); text-align: center; background: var(--clr-surface-hover); border: 1px solid var(--clr-border); border-radius: var(--radius-md);">

              <strong style="font-size: var(--fs-sm);">
                No applications yet
              </strong>

              <p class="text-muted" style="font-size: var(--fs-xs); margin-top: var(--sp-2);">
                Explore available projects and submit your first proposal.
              </p>

              <a href="/projects" class="btn btn-sm btn-primary" style="margin-top: var(--sp-2);">
                Browse Projects →
              </a>

            </div>

          <% } %>

        </div>

      </div>

      <!-- ── Assigned Tasks ────────────────────────────── -->

      <div class="card">

        <div class="card-header">

          <h3 class="card-title">Milestone Tasks</h3>

          <a href="/student/tasks" class="link" style="font-size: var(--fs-xs);">
            View All (<%= totalTasks %>) →
          </a>

        </div>

        <div class="d-flex flex-column gap-3">

          <% if (studentTasks.length > 0) { %>

            <% studentTasks.slice(0, 4).forEach(task => { %>

              <div style="padding: var(--sp-4); background: var(--clr-surface-hover); border: 1px solid var(--clr-border); border-radius: var(--radius-md);">

                <div class="d-flex justify-between align-center mb-1">

                  <strong style="font-size: var(--fs-sm);">
                    <%= task.title || 'Untitled Task' %>
                  </strong>

                  <span class="badge <%= taskBadge(task.status) %>">
                    <%= readableStatus(task.status) %>
                  </span>

                </div>

                <p class="text-secondary" style="font-size: var(--fs-xs); margin-bottom: var(--sp-2);">
                  <%= task.description || 'No task description available.' %>
                </p>

                <div class="d-flex justify-between align-center text-muted" style="font-size: var(--fs-xs);">

                  <span>
                    Due: <%= formatDate(task.dueDate) %>
                  </span>

                  <span>
                    <%= task.priority ? task.priority.toUpperCase() : 'MEDIUM' %>
                  </span>

                </div>

                <% if (task.projectId) { %>
                  <div class="text-muted" style="font-size: var(--fs-xs); margin-top: var(--sp-2);">
                    Project: <%= task.projectId.title || 'Project' %>
                  </div>
                <% } %>

              </div>

            <% }) %>

          <% } else { %>

            <div style="padding: var(--sp-5); text-align: center; background: var(--clr-surface-hover); border: 1px solid var(--clr-border); border-radius: var(--radius-md);">

              <strong style="font-size: var(--fs-sm);">
                No assigned tasks
              </strong>

              <p class="text-muted" style="font-size: var(--fs-xs); margin-top: var(--sp-2);">
                Tasks assigned to you will appear here.
              </p>

            </div>

          <% } %>

        </div>

      </div>

    </div>

    <!-- ═══════════════════════════════════════════════════
         RECOMMENDED PROJECTS
    ═══════════════════════════════════════════════════ -->

    <div class="card">

      <div class="card-header">

        <div>
          <h3 class="card-title">Recommended Opportunities</h3>

          <p class="card-subtitle">
            Available projects matching your eligibility and interests
          </p>
        </div>

        <a href="/projects" class="btn btn-sm btn-secondary">
          Explore All Projects
        </a>

      </div>

      <div class="table-responsive">

        <table class="table">

          <thead>
            <tr>
              <th>Project Title</th>
              <th>Alumni Mentor</th>
              <th>Key Skills</th>
              <th>Duration</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>

            <% if (recommendations.length > 0) { %>

              <% recommendations.slice(0, 5).forEach(project => { %>

                <tr>

                  <td>
                    <strong>
                      <%= project.title || 'Untitled Project' %>
                    </strong>

                    <div class="text-muted" style="font-size: var(--fs-xs);">
                      <%= project.description
                        ? project.description.substring(0, 100) + (project.description.length > 100 ? '...' : '')
                        : 'No description available' %>
                    </div>
                  </td>

                  <td>
                    <%= project.creatorName || 'Not available' %>
                  </td>

                  <td>

                    <% if (project.skills && project.skills.length > 0) { %>

                      <% project.skills.slice(0, 3).forEach(skill => { %>
                        <span class="tag"><%= skill %></span>
                      <% }) %>

                    <% } else { %>

                      <span class="text-muted">Not specified</span>

                    <% } %>

                  </td>

                  <td>
                    <%= project.duration || 'Not specified' %>
                  </td>

                  <td>
                    <a href="/projects" class="btn btn-sm btn-primary">
                      View &amp; Apply
                    </a>
                  </td>

                </tr>

              <% }) %>

            <% } else { %>

              <tr>
                <td colspan="5" style="text-align: center; padding: var(--sp-5);">

                  <strong>No recommended projects available</strong>

                  <div class="text-muted" style="font-size: var(--fs-xs); margin-top: var(--sp-2);">
                    New eligible opportunities will appear here when available.
                  </div>

                  <a href="/projects" class="btn btn-sm btn-secondary" style="margin-top: var(--sp-3);">
                    Browse All Projects
                  </a>

                </td>
              </tr>

            <% } %>

          </tbody>

        </table>

      </div>

    </div>

    <!-- ═══════════════════════════════════════════════════
         RECENT FEEDBACK
    ═══════════════════════════════════════════════════ -->

    <div class="card" style="margin-top: var(--sp-6);">

      <div class="card-header">

        <div>
          <h3 class="card-title">Recent Feedback</h3>

          <p class="card-subtitle">
            Reviews and ratings received from project collaborators
          </p>
        </div>

        <a href="/reviews" class="link" style="font-size: var(--fs-xs);">
          View All Reviews →
        </a>

      </div>

      <div class="d-flex flex-column gap-3">

        <% if (studentReviews.length > 0) { %>

          <% studentReviews.slice(0, 3).forEach(review => { %>

            <div style="padding: var(--sp-4); background: var(--clr-surface-hover); border: 1px solid var(--clr-border); border-radius: var(--radius-md);">

              <div class="d-flex justify-between align-center mb-1">

                <strong style="font-size: var(--fs-sm);">
                  <%= review.reviewerId && review.reviewerId.fullName
                    ? review.reviewerId.fullName
                    : 'Project Collaborator' %>
                </strong>

                <strong style="font-size: var(--fs-sm); color: var(--clr-primary);">
                  <%= review.rating %>/5
                </strong>

              </div>

              <p class="text-secondary" style="font-size: var(--fs-xs); margin-bottom: var(--sp-2);">
                <%= review.feedback || 'No written feedback.' %>
              </p>

              <div class="d-flex justify-between align-center text-muted" style="font-size: var(--fs-xs);">

                <span>
                  Project:
                  <%= review.projectId && review.projectId.title
                    ? review.projectId.title
                    : 'Project' %>
                </span>

                <span>
                  <%= formatDate(review.createdAt) %>
                </span>

              </div>

            </div>

          <% }) %>

        <% } else { %>

          <div style="padding: var(--sp-5); text-align: center; background: var(--clr-surface-hover); border: 1px solid var(--clr-border); border-radius: var(--radius-md);">

            <strong style="font-size: var(--fs-sm);">
              No feedback received yet
            </strong>

            <p class="text-muted" style="font-size: var(--fs-xs); margin-top: var(--sp-2);">
              Reviews from your project collaborators will appear here.
            </p>

          </div>

        <% } %>

      </div>

    </div>

  </div>

</div>

<%- include('../partials/footer') %>
