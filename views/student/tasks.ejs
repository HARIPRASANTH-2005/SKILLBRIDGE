  </aside>

  <!-- Main Content -->
  <div class="dashboard-main">

    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/student/dashboard">Student</a>
      <span aria-hidden="true">/</span>
      <span>Assigned Tasks</span>
    </nav>

    <div class="dashboard-header">
      <div>
        <h1>Assigned Milestone Tasks</h1>
        <p>
          Track your assigned tasks, work on project milestones,
          and submit your completed work for alumni review.
        </p>
      </div>

      <div>
        <a href="/projects" class="btn btn-secondary">
          Browse More Projects
        </a>
      </div>
    </div>

    <!-- Feedback Message -->
    <% if (message) { %>
      <div class="card mb-4" role="status"
        style="border-left: 3px solid var(--clr-brand);">
        <p><%= message %></p>
      </div>
    <% } %>

    <!-- Task Summary -->
    <div class="card mb-6"
      style="border-left: 3px solid var(--clr-brand);">

      <div class="d-flex justify-between align-center flex-wrap gap-2">
        <div>
          <span class="badge badge-active">MY WORKSPACE</span>

          <h2 style="font-size: var(--fs-xl); margin-top: 4px;">
            Assigned Project Tasks
          </h2>

          <div class="text-muted" style="font-size: var(--fs-xs);">
            Total assigned tasks:
            <strong><%= tasks.length %></strong>
          </div>
        </div>

        <a href="/messages" class="btn btn-sm btn-secondary">
          Message Mentor
        </a>
      </div>
    </div>

    <!-- Dynamic Task List -->
    <div class="d-flex flex-wrap gap-4"
      style="flex-direction: column;">

      <% if (tasks.length === 0) { %>

        <div class="card text-center">
          <h3>No Tasks Assigned Yet</h3>

          <p class="text-muted" style="margin-top: 8px;">
            When an alumni assigns tasks to you in an accepted project,
            they will appear here.
          </p>

          <div style="margin-top: 16px;">
            <a href="/projects" class="btn btn-primary">
              Browse Projects
            </a>
          </div>
        </div>

      <% } else { %>

        <% tasks.forEach(task => { %>

          <div class="card">

            <!-- Task Heading -->
            <div class="d-flex justify-between align-center flex-wrap gap-2 mb-3">

              <div class="d-flex align-center gap-3 flex-wrap">

                <% if (task.status === 'todo') { %>
                  <span class="badge badge-pending">TO DO</span>
                <% } else if (task.status === 'in_progress') { %>
                  <span class="badge badge-active">IN PROGRESS</span>
                <% } else if (task.status === 'review') { %>
                  <span class="badge badge-pending">UNDER REVIEW</span>
                <% } else if (task.status === 'completed') { %>
                  <span class="badge badge-approved">COMPLETED</span>
                <% } %>

                <h3 style="font-size: var(--fs-base);">
                  <%= task.title %>
                </h3>

              </div>

              <span class="text-muted" style="font-size: var(--fs-xs);">
                <% if (task.dueDate) { %>
                  Due:
                  <%= new Date(task.dueDate).toLocaleDateString('en-IN', {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric'
                  }) %>
                <% } else { %>
                  No deadline
                <% } %>
              </span>

            </div>

            <!-- Project Information -->
            <div class="text-muted mb-3"
              style="font-size: var(--fs-xs);">

              Project:
              <strong>
                <%= task.projectId ? task.projectId.title : 'Project unavailable' %>
              </strong>

            </div>

            <!-- Task Description -->
            <p class="text-secondary"
              style="font-size: var(--fs-sm); line-height: 1.6; margin-bottom: var(--sp-4);">

              <%= task.description || 'No description provided.' %>

            </p>

            <!-- Task Metadata -->
            <div class="d-flex flex-wrap gap-3 mb-3"
              style="font-size: var(--fs-xs);">

              <span class="text-muted">
                Priority:
                <strong><%= task.priority %></strong>
              </span>

              <span class="text-muted">
                Assigned:
                <%= task.createdAt
                  ? new Date(task.createdAt).toLocaleDateString('en-IN')
                  : 'N/A' %>
              </span>

            </div>

            <!-- Task Actions -->
            <!-- <div class="d-flex justify-between align-center flex-wrap gap-2"
              style="border-top: 1px solid var(--clr-border-subtle); padding-top: var(--sp-3);">

              <div class="text-muted" style="font-size: var(--fs-xs);">

                <% if (task.status === 'todo') { %>
