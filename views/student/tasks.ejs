                <% } %>

              </div>

              <% if (task.status === 'todo') { %>

                <form
                  action="/student/tasks/<%= task._id %>/start"
                  method="POST">

                  <button type="submit" class="btn btn-sm btn-primary">
                    Start Task
                  </button>

                </form>

              <% } else if (task.status === 'in_progress') { %>

