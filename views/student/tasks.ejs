                </span>

              <% } else if (task.status === 'review') { %>

                <span class="badge badge-pending">
                  Awaiting Review
                </span>

              <% } else if (task.status === 'completed') { %>

                <span class="badge badge-approved">
                  Approved
                </span>

              <% } %>

            </div> -->


            <!-- new task actions -->


<!-- Task Actions and Submission -->
<div
  class="d-flex justify-between align-center flex-wrap gap-2"
  style="border-top: 1px solid var(--clr-border-subtle); padding-top: var(--sp-3);">

  <div class="text-muted" style="font-size: var(--fs-xs);">

    <% if (task.status === 'todo') { %>
      Start this task when you are ready to work on it.

    <% } else if (task.status === 'in_progress') { %>
      Complete your work and submit it for alumni review.

    <% } else if (task.status === 'review') { %>
      Your submission is waiting for alumni review.

    <% } else if (task.status === 'completed') { %>
      This task has been approved and completed.
    <% } %>

  </div>

  <% if (task.status === 'todo') { %>

    <form
      action="/student/tasks/<%= task._id %>/start"
      method="POST">

      <button type="submit" class="btn btn-sm btn-primary">
        Start Task
      </button>

    </form>

  <% } else if (task.status === 'review') { %>

    <span class="badge badge-pending">
      Awaiting Alumni Review
    </span>

  <% } else if (task.status === 'completed') { %>

    <span class="badge badge-approved">
      Approved
    </span>

  <% } %>

</div>

<!-- Student Work Submission Form -->
<% if (task.status === 'in_progress') { %>

  <div
    style="border-top: 1px solid var(--clr-border-subtle); margin-top: var(--sp-4); padding-top: var(--sp-4);">

    <h3 style="font-size: var(--fs-base); margin-bottom: var(--sp-3);">
      Submit Your Completed Work
    </h3>

    <form
      action="/student/tasks/<%= task._id %>/submit"
      method="POST">

      <div style="margin-bottom: var(--sp-3);">

        <label for="repositoryUrl-<%= task._id %>">
          GitHub Repository URL <span aria-hidden="true">*</span>
        </label>

        <input
          type="url"
          id="repositoryUrl-<%= task._id %>"
          name="repositoryUrl"
          placeholder="https://github.com/username/project"
          maxlength="500"
          required
          style="width: 100%; margin-top: 6px; padding: 10px; border: 1px solid var(--clr-border-subtle); border-radius: 6px;">

      </div>

      <div style="margin-bottom: var(--sp-3);">

        <label for="deliverableUrl-<%= task._id %>">
          Live Demo / Deliverable URL
          <span class="text-muted">(Optional)</span>
        </label>

        <input
          type="url"
          id="deliverableUrl-<%= task._id %>"
          name="deliverableUrl"
          placeholder="https://your-project-demo.com"
          maxlength="500"
          style="width: 100%; margin-top: 6px; padding: 10px; border: 1px solid var(--clr-border-subtle); border-radius: 6px;">

      </div>

      <div style="margin-bottom: var(--sp-3);">

        <label for="submissionNotes-<%= task._id %>">
          Completion Notes <span aria-hidden="true">*</span>
        </label>

        <textarea
          id="submissionNotes-<%= task._id %>"
          name="submissionNotes"
          rows="4"
          maxlength="3000"
          required
          placeholder="Explain what you implemented, the features completed, and how the work can be verified."
          style="width: 100%; margin-top: 6px; padding: 10px; border: 1px solid var(--clr-border-subtle); border-radius: 6px; resize: vertical;"></textarea>

      </div>

      <button type="submit" class="btn btn-primary">
        Submit Work for Review
      </button>

    </form>

  </div>

<% } %>

<!-- Submitted Work Details -->
<% if (task.status === 'review' || task.status === 'completed') { %>

  <div
    style="border-top: 1px solid var(--clr-border-subtle); margin-top: var(--sp-4); padding-top: var(--sp-4);">

    <h3 style="font-size: var(--fs-base); margin-bottom: var(--sp-3);">
      Submitted Work
    </h3>

    <% if (task.repositoryUrl) { %>
      <p style="font-size: var(--fs-sm); margin-bottom: 8px;">
        <strong>GitHub Repository:</strong>
        <a
          href="<%= task.repositoryUrl %>"
          target="_blank"
          rel="noopener noreferrer">
          View Repository
        </a>
      </p>
    <% } %>

    <% if (task.deliverableUrl) { %>
      <p style="font-size: var(--fs-sm); margin-bottom: 8px;">
        <strong>Deliverable:</strong>
        <a
          href="<%= task.deliverableUrl %>"
          target="_blank"
          rel="noopener noreferrer">
          View Deliverable
        </a>
      </p>
    <% } %>

    <% if (task.submissionNotes) { %>
      <p style="font-size: var(--fs-sm); margin-top: 10px;">
        <strong>Completion Notes:</strong>
      </p>

      <p class="text-secondary"
        style="font-size: var(--fs-sm); line-height: 1.6; margin-top: 5px;">
        <%= task.submissionNotes %>
      </p>
    <% } %>

    <% if (task.submittedAt) { %>
      <p class="text-muted"
        style="font-size: var(--fs-xs); margin-top: 10px;">
        Submitted:
        <%= new Date(task.submittedAt).toLocaleString('en-IN') %>
      </p>
    <% } %>

  </div>

<% } %>

<!-- Alumni Review Feedback -->
<% if (task.reviewFeedback) { %>

  <div
    style="border-top: 1px solid var(--clr-border-subtle); margin-top: var(--sp-4); padding-top: var(--sp-3);">

    <strong style="font-size: var(--fs-sm);">
      Alumni Review Feedback
    </strong>

    <p class="text-secondary"
      style="font-size: var(--fs-sm); line-height: 1.6; margin-top: 6px;">
      <%= task.reviewFeedback %>
    </p>

  </div>

<% } %>

            <!-- Previous Review Feedback -->
            <% if (task.reviewFeedback) { %>

              <div class="mt-3"
                style="border-top: 1px solid var(--clr-border-subtle); padding-top: var(--sp-3);">

                <strong style="font-size: var(--fs-sm);">
                  Alumni Review Feedback
                </strong>

                <p class="text-secondary"
                  style="font-size: var(--fs-sm); margin-top: 6px;">
                  <%= task.reviewFeedback %>
                </p>

              </div>

            <% } %>

          </div>

        <% }) %>

      <% } %>

    </div>

  </div>
</div>

<%- include('../partials/footer') %>
