<%
  const currentStatus = typeof status !== 'undefined' ? status : (typeof user !== 'undefined' && user ? user.status : 'pending');
  const badgeLabel = typeof label !== 'undefined' ? label : null;
%>
<% if (currentStatus === 'approved') { %>
  <span class="trust-badge trust-badge-approved" title="Verified Member — Department Credentials Authenticated">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
      <polyline points="22 4 12 14.01 9 11.01"></polyline>
    </svg>
    <span><%= badgeLabel || 'Verified Member' %></span>
  </span>
<% } else if (currentStatus === 'rejected') { %>
  <span class="trust-badge trust-badge-rejected" title="Application Verification Declined">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="15" y1="9" x2="9" y2="15"></line>
      <line x1="9" y1="9" x2="15" y2="15"></line>
    </svg>
    <span><%= badgeLabel || 'Verification Declined' %></span>
  </span>
<% } else { %>
  <span class="trust-badge trust-badge-pending" title="Awaiting Department Administrator Verification">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10"></circle>
      <polyline points="12 6 12 12 16 14"></polyline>
    </svg>
    <span><%= badgeLabel || 'Pending Verification' %></span>
  </span>
<% } %>

